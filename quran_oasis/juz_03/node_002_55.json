  "tutorContext": {
    "surahName": "البقرة",
    "juz": 3,
    "theme": "يعرض حجاج إبراهيم مع الملك، وآيات الإحياء، وسؤال إبراهيم عن إحياء الموتى، ثم يضرب مثلاً لمضاعفة أجر الصدقة.",
    "ayahMeanings": {
      "258": "تذكر محاجة إبراهيم للملك الذي ادعى القدرة على الإحياء والإماتة، ثم عجزه عن دفع حجة طلوع الشمس.",
      "259": "تعرض سؤال رجل عن إحياء قرية بعد خرابها، ثم آية إماتته وإحيائه وإعمار القرية.",
      "260": "تذكر سؤال إبراهيم ربه أن يريه كيفية إحياء الموتى، وتطمئن قلبه بآية الطير.",
      "261": "تشبه مضاعفة أجر المنفق بحبة أنبتت سبع سنابل، في كل سنبلة مئة حبة.",
      "262": "تعد المنفقين بالأجر إذا لم يتبعوا صدقاتهم بمنّ أو أذى."
    }
