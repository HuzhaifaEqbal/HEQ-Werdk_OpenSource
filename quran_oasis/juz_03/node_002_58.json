  "tutorContext": {
    "surahName": "البقرة",
    "juz": 3,
    "theme": "يقرر حرمة الربا وحل البيع، ويبين أثر الصدقة، ويدعو المؤمنين إلى التقوى وترك ما بقي من الربا.",
    "ayahMeanings": {
      "273": "تصف الفقراء المتعففين الذين لا يسألون الناس، وتدعو إلى التعرف عليهم من سمتهم.",
      "274": "تمدح الذين ينفقون أموالهم في الليل والنهار، سراً وعلانية، وتعدهم بالأجر والأمن.",
      "275": "تصور آكل الربا يوم القيامة، وتفرق بين البيع الحلال والربا المحرم، وتدعو للتوبة.",
      "276": "تقرر أن الله يمحق الربا وينمي الصدقات، ولا يحب كل كفار أثيم.",
      "277": "تعد المؤمنين العاملين بالصلاة والزكاة بالأجر، وتبشرهم بالأمن من الخوف والحزن."
    }
