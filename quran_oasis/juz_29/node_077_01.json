  "tutorContext": {
    "surahName": "المرسلات",
    "juz": 29,
    "theme": "أقسام إلهية عظيمة بالرياح والملائكة التي تنزل بالوحي وتفصل بين الحق والباطل، تأكيداً لحتمية وقوع البعث والجزاء الموعود.",
    "ayahMeanings": {
      "1": "أقسم بالرياح أو الملائكة المتتابعة في إرسالها بالخير والرحمة.",
      "2": "وبالرياح الشديدة الهبوب كالعواصف تدمّر بأمر الله.",
      "3": "وبالملائكة أو السحب التي تنشر الرحمة والمطر نشراً في الآفاق.",
      "4": "وبالملائكة التي تفرّق بين الحق والباطل فرقاً واضحاً جلياً.",
      "5": "وبالملائكة التي تنزل بالوحي والذكر على الأنبياء والرسل.",
      "6": "إعذاراً من الله إلى خلقه بقطع حجتهم وإنذاراً وتخويفاً لمن كفر وعصى.",
      "7": "إن الذي توعدون به من قيام الساعة والحساب والجزاء لواقع لا محالة."
    }
  }
