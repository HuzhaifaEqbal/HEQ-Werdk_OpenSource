  "tutorContext": {
    "surahName": "المرسلات",
    "juz": 29,
    "theme": "بيان علامات قيام الساعة بذهاب ضوء النجوم وانشقاق السماء ونسف الجبال، واجتماع الرسل للشهادة ليوم الفصل العظيم والويل للمكذبين.",
    "ayahMeanings": {
      "8": "فإذا النجوم مُحي نورها وذهب ضياؤها.",
      "9": "وإذا السماء تصدّعت وانشقت لنزول الملائكة.",
      "10": "وإذا الجبال قُلعت من أماكنها وفُتّتت حتى صارت هباءً منثوراً.",
      "11": "وإذا الرسل جُمعت في وقت محدد للشهادة على أممها بالتبليغ.",
      "12": "لأي يوم عظيم أُخِّر هذا الجمع وأُجِّل؟",
      "13": "أُخِّر ليوم الفصل بين الخلائق بالقسط والعدل.",
      "14": "وما أعلمك يا محمد ما عظمة ذلك اليوم وشدة هوله؟",
      "15": "هلاك وعذاب وخسران شديد في ذلك اليوم للجاحدين المكذبين بالحق."
    }
  }
}