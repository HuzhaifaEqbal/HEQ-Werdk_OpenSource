  "tutorContext": {
    "surahName": "القيامة",
    "juz": 29,
    "theme": "تصوير أهوال القيامة المروعة بتحير البصر وخسوف القمر وجمع الشمس والقمر، وفزع الكافر ومحاولته الفرار واللجوء ولا ملجأ إلا إلى الله.",
    "ayahMeanings": {
      "6": "يسأل مستهزءاً ومستبعداً: متى موعد يوم القيامة؟",
      "7": "فإذا تحيَّر البصر وشَخَصَ من شدة الفزع والهول.",
      "8": "وأظلم القمر وذهب ضوؤه.",
      "9": "وجُمع بين الشمس والقمر في طلوعهما وغروبهما أو ذهاب نورهما.",
      "10": "يقول الإنسان الكافر يومئذ من الفزع: أين المهرب والمفر؟",
      "11": "كلا ليس الأمر كما تظن، فلا ملجأ ولا منجى من عذاب الله.",
      "12": "إلى ربك وحدك يومئذ مصير الخلائق واستقرارهم للجزاء والحساب."
    }
  }
}