  "tutorContext": {
    "surahName": "الجن",
    "juz": 29,
    "theme": "افتقار النبي ﷺ إلى حماية ربه وانحصار مهمته في البلاغ، ووعيد من عصى الله ورسوله بخلود جهنم، وجهله بوقت العذاب الموعود",
    "ayahMeanings": {
      "22": "قل: إني لن يحميني وينقذني من عذاب الله أحد إن عصيته، ولن أجد من دونه ملجأ ولا ملاذاً ألتجئ إليه.",
      "23": "لكن أملك لكم بلاغاً من الله أبلغه ورسالات أوصلها، ومن يعص الله ورسوله بالكفر والردة فإن له نار جهنم خالدين فيها أبداً.",
      "24": "حتى إذا رأى الكفار ما يوعدون به من العذاب يوم القيامة، فسيعلمون عند المعاينة من هو أضعف ناصراً وأقل جنداً وعدداً.",
      "25": "قل يا محمد: لا أدري أهذا العذاب الموعود قريب وقته، أم يجعل له ربي مدة طويلة وأجلاً ممتداً."
    }
  }
