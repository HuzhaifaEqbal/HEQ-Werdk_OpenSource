  "tutorContext": {
    "surahName": "الملك",
    "juz": 29,
    "theme": "جزاء الخاشعين لله بالغيب، وإحاطة علم الله بالسر والعلانية، وتذليل الأرض للإنسان للسعي في مناكبها",
    "ayahMeanings": {
      "11": "فاعترفوا بذنوبهم حين لا ينفع الاعتراف، فبعداً وسحقاً وخسراناً لأهل النار.",
      "12": "إن الذين يخافون ربهم بالغيب وهم لم يروه، لهم غفران عظيم لذنوبهم وأجر كبير في الجنة.",
      "13": "وأخفوا كلامكم أيها الناس أو أعلنوه، فهو سبحانه عليم بما تنطوي عليه الصدور والضمائر.",
      "14": "ألا يعلم الخالق سبحانه ما خلق وهو الذي أوجده؟ وهو اللطيف بدقائق الأشياء الخبير بخفاياها.",
      "15": "هو الذي جعل لكم الأرض سهلة ممهدة للسكنى، فامشوا في جوانبها وأرجائها وكلوا من رزقه وإليه المرجع والبعث."
    }
  }
