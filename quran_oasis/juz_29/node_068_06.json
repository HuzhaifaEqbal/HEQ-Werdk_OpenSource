  "tutorContext": {
    "surahName": "القلم",
    "juz": 29,
    "theme": "اعتراف أصحاب الجنة بظلمهم وتلاومهم بينهم، وتوبتهم ورجاؤهم أن يبدلهم ربهم خيراً منها، وبيان أن عذاب الآخرة أكبر",
    "ayahMeanings": {
      "29": "قالوا نادمين: ننزه ربنا تنزيهاً كاملاً عن الظلم، إنا كنا نحن الظالمين لأنفسنا بمنع الفقراء حقهم.",
      "30": "فأقبل بعضهم على بعض يلوم كل واحد منهم صاحبه على سوء تدبيرهم وقصدهم.",
      "31": "قالوا جميعاً: يا ويلنا ويا هلاكنا إنا كنا معتدين متجاوزين الحد في منع الحق والبخل.",
      "32": "عسى ربنا إن تبنا إليه أن يبدلنا حديقة خيراً من حديقتنا الهالكة، إنا إلى ربنا وحده راغبون تائبون.",
      "33": "مثل هذا البلاء والعذاب الشديد نعذب من خالف أمرنا في الدنيا، ولعذاب الآخرة أكبر وأشد لو كانوا يعلمون."
    }
  }
