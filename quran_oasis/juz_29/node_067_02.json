  "tutorContext": {
    "surahName": "الملك",
    "juz": 29,
    "theme": "بيان عذاب جهنم وشدة غيظها على الكافرين، وحوار خزنة النار معهم واعترافهم بتعطيل أسماعهم وعقولهم",
    "ayahMeanings": {
      "6": "وللذين جحدوا بربهم وكفروا به عذاب جهنم وبئس المرجع والمصير.",
      "7": "إذا طرحوا في جهنم سمعوا لها صوتاً منكراً فظيعاً كصوت الحمار عند الشهيق وهي تغلي بهم كغلي المرجل.",
      "8": "تكاد النار تتقطع وتتفرق من شدة غيظها وغضبها على الكفار، كلما ألقي فيها فوج سألهم خزنتها توبيخاً: ألم يأتكم نذير في الدنيا؟",
      "9": "قالوا بلى قد جاءنا نذير فكذبناه وقلنا ما أنزل الله من وحي، إن أنتم إلا في ضلال عظيم.",
      "10": "وقالوا معترفين: لو كنا نسمع سماع طالب الحق أو نعقل عقل من يميز لما كنا اليوم من أهل النار."
    }
  }
