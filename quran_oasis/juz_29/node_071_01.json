  "tutorContext": {
    "surahName": "نوح",
    "juz": 29,
    "theme": "إرسال نوح عليه السلام نذيراً مبيناً لقومه، ودعوتهم لإفراد الله بالعبادة والتقوى لنيل مغفرة الذنوب وتأخير الأجل",
    "ayahMeanings": {
      "1": "إنا بعثنا نوحاً إلى قومه برسالتنا وأمرناه أن ينذر قومه من عذاب أليم يأتيهم إن لم يتوبوا.",
      "2": "قال نوح لقومه: يا قوم إني لكم منذر واضح الإنذار أبيّن لكم سبيل النجاة من الهلاك.",
      "3": "أن أخلصوا العبادة لله وحده وخافوا عقابه بامتثال أوامره وأطيعوني فيما بلغتكم.",
      "4": "إن فعلتم ذلك يغفر الله لكم ذنوبكم ويمد في أعماركم في عافية، فإن أجل الموت إذا جاء وقته المحتوم لا يؤخر أبداً."
    }
  }
