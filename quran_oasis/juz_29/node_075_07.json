  "tutorContext": {
    "surahName": "القيامة",
    "juz": 29,
    "theme": "الاستدلال بأطوار خلق الإنسان العجيبة من نطفة فعلقة ثم تسويته ذكراً وأنثى، على كمال قدرة الله سبحانه على بعث الموتى وإحيائهم.",
    "ayahMeanings": {
      "36": "أيحسب هذا الإنسان الجاحد أن يُترك مهملاً لا يؤمر ولا ينهى ولا يُحاسب؟",
      "37": "ألم يكن في ابتداء خلقه قطرة من مني تُمْنَى وتُصب في الأرحام؟",
      "38": "ثم صار بعد ذلك قطعة دم جامدة (علقة)، فخلقه الله وصوّره في أحسن تقويم وسوّى أعضاءه؟",
      "39": "فجعل من هذا الإنسان الصنفين والنوعين: الذكر والأنثى بقدرته وحكمته؟",
      "40": "أليس ذلك الإله العظيم القادر على بدء هذا الخلق بقادر على إحياء الموتى يوم القيامة؟"
    }
  }
