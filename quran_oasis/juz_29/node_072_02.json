  "tutorContext": {
    "surahName": "الجن",
    "juz": 29,
    "theme": "إبطال استعاذة الإنس بالجن في الجاهلية، وبيان حراسة السماء بالملائكة والشهب الثواقب لمنع استراق السمع حفظاً للقرآن",
    "ayahMeanings": {
      "6": "وكان رجال من الإنس يستعيذون بسادة الجن في الأودية والمفاوز، فزاد الإنسُ الجنَّ تكبراً وطغياناً، وزاد الجنُّ الإنسَ خوفاً وإثماً.",
      "7": "وظن كفار الإنس كما ظننتم أن الله لن يبعث أحداً بعد الموت للحساب والجزاء.",
      "8": "وقالت الجن: صعدنا إلى السماء لنسترق السمع فوجدناها قد ملئت حرساً شديداً من الملائكة وشهباً محرقة ترمى علينا.",
      "9": "وكنا قبل بعثة محمد نأخذ مقاعد في السماء لنستمع الأخبار، فمن يحاول استراق السمع الآن يجد له شهاباً راصداً يحرقه ويهلكه."
    }
  }
