  "tutorContext": {
    "surahName": "الملك",
    "juz": 29,
    "theme": "تمجيد الله تعالى وكمال سلطانه، وبيان الحكمة من خلق الموت والحياة، وإتقان خلق السماوات وتزيينها بالمصابيح",
    "ayahMeanings": {
      "1": "تكاثر خير الله وبركته وعظم سلطانه، بيده تصريف ملك السماوات والأرض وهو على كل شيء قدير.",
      "2": "الذي أوجد الموت والحياة ليختبركم: أيكم أخلص وأصوب عملاً، وهو العزيز المنتقم الغفور لمن تاب.",
      "3": "الذي خلق سبع سماوات متطابقة طبقة فوق أخرى بلا خلل ولا تنافر، فانظر في خلق الرحمن هل تجد فيه أي شق أو نقص؟",
      "4": "ثم كرر النظر كرة بعد كرة، يرجع إليك بصرك خائباً صاغراً وهو كليل منقطع عن رؤية أي عيب.",
      "5": "ولقد زينا السماء القريبة منكم بنجوم مضيئة وجعلنا منها شهباً ترجم الشياطين، وأعددنا لهم نار السعير."
    }
  }
}