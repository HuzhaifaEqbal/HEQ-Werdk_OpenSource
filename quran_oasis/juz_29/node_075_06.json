  "tutorContext": {
    "surahName": "القيامة",
    "juz": 29,
    "theme": "بيان حال الكافر المستكبر الذي كذب بالحق وتولى عن الطاعة واختال في مشيته، والوعيد الشديد المكرر له بالهلاك والدمار.",
    "ayahMeanings": {
      "31": "فلا آمن ولا صدّق بالحق والقرآن، ولا أدّى لله الصلاة المفروضة.",
      "32": "ولكن كذّب بآيات ربه وأعرض وتولى عن الإيمان والهدى.",
      "33": "ثم ذهب إلى أهله يمشي متبختراً فخوراً في مشيته ومعجباً بنفسه.",
      "34": "هلاك لك يا أيها الكافر وقرب منك ما يسوءك، فهلاك لك.",
      "35": "ثم هلاك لك وعذاب دائم يقرب منك، فهلاك لك."
    }
  }
