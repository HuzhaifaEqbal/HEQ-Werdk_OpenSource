  "tutorContext": {
    "surahName": "القلم",
    "juz": 29,
    "theme": "مضي أصحاب الجنة في عزمهم لحرمان المساكين، وصدمتهم بهلاك جنتهم وتذكير أوسطهم لهم بالتسبيح",
    "ayahMeanings": {
      "23": "فانطلقوا مسرعين وهم يتحدثون بصوت خافت لئلا يسمعهم أحد.",
      "24": "يقول بعضهم لبعض: احذروا أن يدخل عليكم اليوم في الحديقة مسكين فيسألكم من ثمارها.",
      "25": "وخرجوا في الصباح الباكر على نية منع الفقراء وبخل وحنق، وهم يظنون أنهم قادرون على أمرهم وجنتهم.",
      "26": "فلما رأوها محترقة سوداء أنكروها وقالوا: إنا قد ضللنا طريق بستاننا وليست هذه أرضنا.",
      "27": "فلما تحققوا أنها هي قالوا: بل نحن محرومون خيرها وثمارها بشؤم عزمنا ومنعنا للمساكين.",
      "28": "قال أعدلهم وأعقلهم وخيرهم: ألم أقل لكم هلا سبحتم الله وشكرتموه واستثنيتم مشيئته؟"
    }
  }
