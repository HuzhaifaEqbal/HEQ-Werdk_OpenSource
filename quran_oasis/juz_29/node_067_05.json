  "tutorContext": {
    "surahName": "الملك",
    "juz": 29,
    "theme": "بيان انفراد الله بالرزق، ومثل المهتدي الماشي سوياً والضال المنكب على وجهه، والتذكير بنعمة الحواس وسؤال الكفار عن موعد القيامة",
    "ayahMeanings": {
      "21": "بل من هذا الذي يسوق إليكم الرزق إن أمسك الله أسباب رزقه ومطره؟ بل تمادوا واستمروا في استكبار وعناد وتباعد عن الحق.",
      "22": "أفمن يمشي منكساً رأسه ساقطاً على وجهه لا يدري أين يذهب أهدى طريقاً، أم من يمشي معتدل القامة منتصب الرأس على طريق واضح مستقيم؟",
      "23": "قل يا محمد: الله هو الذي أوجدكم بعد العدم وركب فيكم السمع والأبصار والعقول لتشكروه، ولكنكم قليلاً ما تشكرون هذه النعم.",
      "24": "قل: هو الذي بثكم ونشركم في بقاع الأرض، وإليه وحده تجمعون يوم القيامة للحساب والجزاء.",
      "25": "ويقول الكفار استهزاءً وتكذيباً: متى يتحقق هذا البعث وهذا الوعد إن كنتم صادقين فيما تدعون؟"
    }
  }
}