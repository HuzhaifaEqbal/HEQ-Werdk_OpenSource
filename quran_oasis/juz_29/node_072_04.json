  "tutorContext": {
    "surahName": "الجن",
    "juz": 29,
    "theme": "جزاء المسلمين بالرشد ومصير القاسطين الجائرين وقوداً لجهنم، ووعد الله بالسعة والماء الغدق لمن استقام، والوعيد بالعذاب الصعد للمعرضين",
    "ayahMeanings": {
      "14": "ومنا الخاضعون لله بالطاعة، ومنا الجائرون الظالمون عن طريق الحق، فمن أسلم فأولئك قصدوا طريق الهداية والرشاد.",
      "15": "وأما الجائرون الظالمون فكانوا لنار جهنم وقوداً وحطباً تشتعل بهم.",
      "16": "ولو أن الإنس والجن استقاموا على طريقة الإسلام وتوحيد الله لأنزلنا عليهم ماءً كثيراً ورزقاً واسعاً رغداً.",
      "17": "لنختبرهم في تلك النعمة: هل يشكرون أم يكفرون؟ ومن يعرض عن طاعة ربه وتذكره يدخله عذاباً شاقاً متصاعداً شديد المشقة."
    }
  }
