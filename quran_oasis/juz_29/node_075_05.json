  "tutorContext": {
    "surahName": "القيامة",
    "juz": 29,
    "theme": "لحظات خروج الروح وبلوغها التراقي وعجز الأطباء، وفراق الدنيا والتفاف الساق بالساق وسياقة العباد إلى الله للحساب.",
    "ayahMeanings": {
      "26": "حقاً إذا بلغت الروح عظام أعالي الصدر عند الاحتضار.",
      "27": "وقال الحاضرون حول المحتضر طلباً لشفائه: من يرقيه أو يداويه ليبرأ؟",
      "28": "وأيقن المحتضر حينئذ أنه فراق الدنيا ومفارقة الأهل والأحباب.",
      "29": "والتفت شدة كرب الموت بشدة كرب فراق الدنيا والقدوم على الآخرة.",
      "30": "إلى ربك وسيدك يومئذ يُساق العباد ليجازيهم بأعمالهم."
    }
  }
