  "tutorContext": {
    "surahName": "المدثر",
    "juz": 29,
    "theme": "سؤال أهل الجنة للمجرمين في سقر عن سبب هلاكهم، واعترافهم بترك الصلاة وإطعام المسكين والخوض مع أهل الباطل والتكذيب بيوم الدين حتى الموت",
    "ayahMeanings": {
      "38": "كل نفس محبوسة ومرهونة بكسبها وعملها السيئ.",
      "39": "إلا أصحاب اليمين المؤمنين فقد فكوا رقابهم بالطاعة والإيمان.",
      "40": "في بساتين وجنات يتساءلون من علوهم.",
      "41": "يسألون عن حال المجرمين الكفار المعذبين في النار.",
      "42": "قائلين لهم توبيخاً: ما الذي أدخلكم وأوردكم نار سقر؟",
      "43": "قال المجرمون: لم نكن في الدنيا من المصلين المقيمين لحق الله.",
      "44": "ولم نكن ننفق على الفقراء والمساكين ونطعمهم.",
      "45": "وكنا نتحدث بالباطل والضلال مع أهل الباطل والخوض في آيات الله.",
      "46": "وكنا نكذب بيوم الجزاء والحساب ولا نصدق بالبعث.",
      "47": "حتى جاءنا الموت والحق اليقين ونحن على حال التكذيب."
    }
  }
}