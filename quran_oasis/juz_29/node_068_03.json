  "tutorContext": {
    "surahName": "القلم",
    "juz": 29,
    "theme": "استكمال صفات الفاجر المستكبر بماله وولده وتكذيبه بالقرآن، ووعيده بالوسم والعلامة المذلة على أنفه",
    "ayahMeanings": {
      "12": "كثير المنع للخير وبذل المال، متجاوز للحدود في الظلم، مرتكب للآثام والمعاصي.",
      "13": "غليظ جاف قاسٍ في كفره، دعي ملصق في قومه مشهور بالشر والخسة.",
      "14": "لأجل أنه كان صاحب مال وفير وبنين تكبر وطغى وكذب الرسل.",
      "15": "إذا تُقرأ عليه آيات القرآن كذب بها وقال: هذه خرافات وأباطيل الأمم السابقة.",
      "16": "سنجعل له علامة خزي وعار ظاهرة على أنفه (خرطومه) لا تفارقه أبداً في الدنيا والآخرة."
    }
  }
