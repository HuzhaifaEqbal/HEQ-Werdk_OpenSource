  "tutorContext": {
    "surahName": "الجن",
    "juz": 29,
    "theme": "انفراد الله بعلم الغيب المطلق، وإطلاع من ارتضى من رسله مع إحاطتهم بحرس ملائكي، وإحاطة علمه الشامل وإحصاء كل شيء عدداً",
    "ayahMeanings": {
      "26": "الله وحده عالم ما غاب عن الأبصار والعقول، فلا يطلع على غيبه الكامل أحداً من خلقه.",
      "27": "إلا من اختاره واصطفاه من رسله فيطلعه على ما يشاء من الغيب بالوحي، ويرسل من أمامه ومن خلفه ملائكة حراساً يحفظونه من استراق الشياطين.",
      "28": "ليعلم الرسول ويعلم الناس أن الرسل قد بلغوا رسالات ربهم تامة محروسة، وقد أحاط الله بكل ما عندهم علماً وأحصى كل شيء في الكون عدداً."
    }
  }
