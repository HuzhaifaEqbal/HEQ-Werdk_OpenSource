  "tutorContext": {
    "surahName": "المدثر",
    "juz": 29,
    "theme": "بدء مرحلة الرسالة والإنذار، وأمر النبي ﷺ بتعظيم ربه وتطهير ثيابه وهجر الأوثان والإخلاص في العطاء والصبر لوجه الله",
    "ayahMeanings": {
      "1": "يا أيها المتلفف بثيابه وغطائه (محمد ﷺ).",
      "2": "قم بجد وعزم فأنذر الناس وخوفهم من عذاب الله إن لم يؤمنوا.",
      "3": "وخص ربك وحده بالتعظيم والتكبير ولا تشرك به أحداً.",
      "4": "وطهر ثيابك وبدنك من النجاسات، وطهر باطنك من المعاصي والآثام.",
      "5": "واثبت على هجر الأصنام والأوثان وسائر المعاصي والرجس.",
      "6": "ولا تعط العطاء وأنت ترجو أن تأخذ أكثر منه أو تمنّ به على الناس.",
      "7": "ولأجل ربك وابتغاء مرضاته فاصبر على أذى قومك وثقل أعباء الدعوة."
    }
  }
}