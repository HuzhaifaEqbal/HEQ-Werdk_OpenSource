  "tutorContext": {
    "surahName": "نوح",
    "juz": 29,
    "theme": "بيان فضائل وثمرات الاستغفار العاجلة من المطر الغزير والأموال والبنين والبساتين، وتذكيرهم بتعظيم الله وخلقه الإنسان أطواراً",
    "ayahMeanings": {
      "10": "فقلت لقومي: ارجعوا إلى ربكم وتوبوا إليه واستغفروه من ذنوبكم، إنه سبحانه كان غفاراً لمن أناب.",
      "11": "إن استغفرتم ينزل عليكم المطر متتابعاً غزيراً يحيي به الأرض.",
      "12": "ويكثر أموالكم وأولادكم ويجعل لكم بساتين نضرة وأنهاراً جارية عذبة.",
      "13": "ما بالكم لا تخافون عظمة الله وجلاله ولا ترجون له التوقير والتعظيم؟",
      "14": "وقد أوجدكم وخلقكم في بطون أمهاتكم مرحلة بعد مرحلة: نطفة ثم علقة ثم مضغة حتى صرتم خلقاً سوياً."
    }
  }
