  "tutorContext": {
    "surahName": "المزمل",
    "juz": 29,
    "theme": "تذكير قريش بعقوبة فرعون حين عصى رسوله موسى، والتحذير من هول يوم القيامة الذي يشيب فيه الولدان وتنفطر فيه السماء",
    "ayahMeanings": {
      "15": "إنا أرسلنا إليكم يا أهل مكة رسولاً (محمداً ﷺ) شاهداً عليكم بأعمالكم كما أرسلنا إلى فرعون موسى رسولاً.",
      "16": "فعصى فرعون رسول ربه وكذب به، فأخذناه بالعقوبة أخذاً ثقيلاً شديداً فأغرقناه وجنوده.",
      "17": "فكيف تقون أنفسكم عذاب يوم عظيم يشيب فيه الصغار من شدة هوله وفزعه إن كفرتم بالله؟",
      "18": "السماء على عظمها وإحكامها متصدعة ومنفطرة في ذلك اليوم، وكان وعد الله بالبعث واقعاً مفعولاً لا محالة.",
      "19": "إن هذه الآيات والمواعظ تذكرة وعظة، فمن شاء اتعظ واتخذ بالإيمان والتقوى طريقاً إلى ربه وجنته."
    }
  }
