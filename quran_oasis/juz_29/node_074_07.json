    "theme": "القسم بالقمر وإدبار الليل وإشراق الصبح على أن جهنم إحدى الدواهي العظام، نذيراً للإنس لمن شاء أن يتقدم بالطاعة أو يتأخر بالمعصية",
    "ayahMeanings": {
      "32": "حقاً أقسم بالقمر المنير في السماء.",
      "33": "وبالليل إذا ولى وذهب ظلامه.",
      "34": "وبالصبح إذا أضاء وأسفر نوره.",
      "35": "إن نار سقر لإحدى الدواهي والبلايا العظام في هولها وشدتها.",
      "36": "إنذاراً وتخويفاً للبشر من عذاب الله وبأسه.",
      "37": "لمن شاء منكم أن يتقدم إلى ربه بالإيمان وفعل الطاعات، أو يتأخر بالكفر وارتكاب المعاصي."
    }
  }
