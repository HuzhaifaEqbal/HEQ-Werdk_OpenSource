  "tutorContext": {
    "surahName": "الإنسان",
    "juz": 29,
    "theme": "وقاية الله للأبرار من شر ذلك اليوم، وجزاؤهم بالجنة والحرير والاتكاء على الأرائك بلا حر ولا زمهرير، وظلال الأشجار وثمارها الدانية وأكواب الفضة وقواريرها المقدرة.",
    "ayahMeanings": {
      "11": "فحماهم الله ودفع عنهم شدة ذلك اليوم، ولقّاهم حسناً ونضارة في وجوههم وفرحاً في قلوبهم.",
      "12": "وأثابهم بصبرهم على الطاعات وعن المعاصي جنة عظيمة ولباساً من حرير ناعم.",
      "13": "متكئين فيها على الأسِرَّة المزيّنة، لا يرون فيها حر شمس يؤذيهم ولا شدة برد زمهرير.",
      "14": "وقريبة منهم ظلال أشجارها، وذُللت ثمارها تسهيلاً لمن أراد قطافها قائماً أو قاعداً أو مضطجعاً.",
      "15": "ويُطاف عليهم بآنية من فضة وأكواب صافية كالزجاج كانت في غاية الجمال.",
      "16": "قوارير مصنوعة من فضة بصفاء الزجاج، قدّرها السقاة على قدر ريّ الشاربين من غير زيادة ولا نقصان."
    }
  }
}