  "tutorContext": {
    "surahName": "نوح",
    "juz": 29,
    "theme": "عقوبة قوم نوح بالطوفان وإدخالهم النار، ودعاء نوح باستئصال الكافرين ودعائه بالمغفرة لوالديه وللمؤمنين والمؤمنات",
    "ayahMeanings": {
      "25": "بسبب ذنوبهم العظيمة وإصرارهم على الكفر أُغرقوا بماء الطوفان فأُدخلوا عقب ذلك نار البرزخ وجهنم، فلم يجدوا ناصراً ينقذهم من بأس الله.",
      "26": "وقال نوح داعياً بعد يأسهم: رب لا تترك على وجه الأرض أحداً من الكافرين يدور ويسكن فيها.",
      "27": "إنك إن تبقهم يضلوا من يولد من عبادك، ولا يلدوا إلا فاجراً في عمله شديد الكفر بربه.",
      "28": "رب اغفر لي خطيئتي ولوالديّ ولمن دخل بيتي مؤمناً ولجميع المؤمنين والمؤمنات إلى يوم القيامة، ولا تزد الظالمين إلا هلاكاً ودماراً وخسراناً."
    }
  }
