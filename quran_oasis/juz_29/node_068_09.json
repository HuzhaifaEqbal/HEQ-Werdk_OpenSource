  "tutorContext": {
    "surahName": "القلم",
    "juz": 29,
    "theme": "وعيد الله للمكذبين بالقرآن بالاستدراج والإملاء، وتذكيرهم بأن النبي ﷺ لا يسألهم أجراً ولا يملكون علم الغيب",
    "ayahMeanings": {
      "44": "فدعني يا محمد ومن يكذب بهذا القرآن، فإنا سنستدرجهم بالنعم ليزدادوا إثماً من حيث لا يعلمون أنها استدراج.",
      "45": "وأمهلهم وأطيل أعمارهم ليزدادوا طغياناً، إن تدبيري وكيدي بأعدائي قوي محكم متين.",
      "46": "أم تسألهم يا محمد مالاً وأجراً على تبليغ الرسالة، فهم من ثقل الغرم والغرامة مثقلون متعبون؟",
      "47": "أم عندهم اللوح المحفوظ وعلم الغيب، فهم يكتبون منه ما يزعمونه ويحكمون به؟"
    }
  }
