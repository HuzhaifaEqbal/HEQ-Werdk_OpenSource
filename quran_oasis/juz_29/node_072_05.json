  "tutorContext": {
    "surahName": "الجن",
    "juz": 29,
    "theme": "الأمر بإخلاص بيوت الله ومواضع السجود لله وحده، وتكالب الجن على سماع النبي ﷺ وإعلانه التام أنه لا يملك لأحد ضراً ولا رشداً",
    "ayahMeanings": {
      "18": "وأن المساجد ومواضع الصلاة خالصة لله وحده، فلا تعبدوا ولا تدعوا فيها مع الله أحداً من خلقه.",
      "19": "ولما قام محمد عبد الله ورسوله يدعوه ويعبده، كادت الجن تتراكم عليه جماعات متراكبة رغبة في سماع القرآن.",
      "20": "قل يا محمد للمشركين: إنما أعبد ربي وحده مخلصاً له ديني، ولا أشرك بعبادته أحداً قط.",
      "21": "قل: إني عبد لا أملك لكم دفع ضر ولا جلب نفع أو هداية، فالأمر كله بيد الله وحده."
    }
  }
