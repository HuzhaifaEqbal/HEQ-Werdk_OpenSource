  "tutorContext": {
    "surahName": "المرسلات",
    "juz": 29,
    "theme": "جزاء المتقين ومآلهم في الجنات والظلال الوارفة والعيون الجارية والفواكه المشتهاة، وتكريمهم بالأكل والشرب الهنيء جزاء ما أسلَفوا من إحسان.",
    "ayahMeanings": {
      "41": "إن المتقين لله بطاعته واجتناب معاصيه في ظلال وارفة وعيون ماء عذبة جارية.",
      "42": "وفواكه كثيرة ولذيذة مما يشتهون وترغب به نفوسهم.",
      "43": "يقال لهم تكريماً: كلوا واشربوا هنيئاً مريئاً بسبب ما قدمتم من الأعمال الصالحة في دنياكم.",
      "44": "إنا بمثل هذا الجزاء العظيم نكافئ ونثيب المحسنين في عبادة ربهم ومعاملة خلقه.",
      "45": "ويل وهلاك وعذاب دائم يومئذ لمن كذب بهذا النعيم وهذا اليوم."
    }
  }
