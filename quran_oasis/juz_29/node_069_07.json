  "tutorContext": {
    "surahName": "الحاقة",
    "juz": 29,
    "theme": "بيان سبب عذاب الشقي لبخله وقسوته، وحرمانه من الصديق الحميم، وأن طعامه غسالة أهل النار لا يأكله إلا الخاطئون",
    "ayahMeanings": {
      "34": "وكان في دنياه لا يحث نفسه ولا غيره على بذل الطعام للمحتاجين والفقراء لقسوة قلبه وبخله.",
      "35": "فليس له اليوم في هذا الموقف الرهيب قريب حميم يشفق عليه أو يدفع عنه العذاب.",
      "36": "وليس له طعام إلا من صديد وقيح أهل النار المنتن شديد الحرارة.",
      "37": "لا يأكل هذا الطعام الخبيث إلا الخاطئون الذين تمادوا في الكفر والآثام والمعاصي."
    }
