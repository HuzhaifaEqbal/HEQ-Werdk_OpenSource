  "tutorContext": {
    "surahName": "المدثر",
    "juz": 29,
    "theme": "تذكير الوليد بن المغيرة بنعم الله عليه من المال الممدود والبنين الحضور، ومقابلته ذلك بالعناد، وتوعده بتكليفه عقبة شاقة في النار (صعودا)",
    "ayahMeanings": {
      "11": "دعني يا محمد ومن خلقته وحيداً في بطن أمه فريداً لا مال له ولا ولد (الوليد بن المغيرة).",
      "12": "وجعلت له مالاً كثيراً واسعاً ممدوداً متسعاً.",
      "13": "وأولاداً حضوراً معه بمكة يتمتع بمشاهدتهم ومعونتهم.",
      "14": "وبسطت له في سبل العيش والرياسة والجاه تمهيداً واسعاً.",
      "15": "ثم يطمع مع كفره وجحوده أن أزيده في ماله وولده.",
      "16": "كلا، لن أزيده؛ إنه كان لآياتنا وحججنا معانداً مكذباً معارضاً للحق.",
      "17": "سأكلفه عذاباً شاقاً شديداً يصعد فيه في جبل من نار في جهنم."
    }
  }
}