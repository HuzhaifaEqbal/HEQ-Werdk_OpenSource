  "tutorContext": {
    "surahName": "الجن",
    "juz": 29,
    "theme": "إيحاء الله لنبيه باستماع جماعة من الجن للقرآن وانبهارهم به، وتوحيدهم لله ونفي الصاحبة والولد، واستنكار شطط إبليس",
    "ayahMeanings": {
      "1": "قل يا محمد: أوحى الله إليّ أن جماعة من الجن استمعوا لتلاوتي للقرآن فقالوا لقومهم: إنا سمعنا قرآناً بديعاً عجيباً في بلاغته وأحكامه.",
      "2": "يدعو إلى طريق الحق والهدى فآمنا به وصدقناه، ولن نشرك بعبادة ربنا أحداً بعد اليوم.",
      "3": "وتعالت وتعاظمت عظمة ربنا وجلاله وسلطانه، ما اتخذ زوجة ولا ولداً كما زعم المشركون.",
      "4": "وإن الجاهل منا (إبليس ومردة الجن) كان يفتري على الله قولاً جائراً متجاوزاً للحق والحد.",
      "5": "وكنا نظن قبل سماع القرآن أن أحداً من الإنس أو الجن لن يجرؤ على أن يكذب على الله بنسبة الشريك والصاحبة والولد."
    }
  }
