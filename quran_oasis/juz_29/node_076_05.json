  "tutorContext": {
    "surahName": "الإنسان",
    "juz": 29,
    "theme": "امتنان الله بإنزال القرآن مفرّقاً على رسوله ﷺ، والأمر بالصبر لحكم ربه وعدم إطاعة الآثم والكفور، ومداومة ذكر اسم الله والتسبيح ليلاً طويلاً.",
    "ayahMeanings": {
      "23": "إنا نحن وحدنا أنزلنا عليك يا محمد القرآن الكريم تنزيلاً مفرّقاً حكمةً ورحمة.",
      "24": "فاصبر لقضاء ربك وأمره الشرعي والقدري، ولا تطع أحداً من الكافرين مبالغاً في الإثم أو فائقاً في الكفر.",
      "25": "واذكر اسم ربك بالدعاء والصلاة في أول النهار عند الصباح وفي آخره عند المساء.",
      "26": "ومن الليل فاسجد له مصلّياً، وسبّحه ونزّهه ليلاً طويلاً في صلاة التهجد والقيام."
    }
  }
