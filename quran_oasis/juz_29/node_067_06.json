  "tutorContext": {
    "surahName": "الملك",
    "juz": 29,
    "theme": "علم وقت القيامة عند الله وحده، واسوداد وجوه الكفار عند معاينة العذاب، والتوكل على الرحمن، وآية الماء المعين الجاري",
    "ayahMeanings": {
      "26": "قل إنما علم وقت قيام الساعة عند الله وحده لا يعلمه غيره، وإنما أنا نذير لكم مبيّن ناصح ومحذر.",
      "27": "فلما رأوا العذاب واقعاً قريباً منهم في الآخرة، علت وجوه الكافرين الكآبة والذلة والخزي، وقيل لهم توبيخاً: هذا العذاب الذي كنتم به تكذبون وتستعجلون.",
      "28": "قل: أخبروني إن أماتني الله ومَن معي أو رحمنا فأخر آجالنا، فمن ذا الذي يحمي الكافرين وينقذهم من عذاب الله الأليم؟",
      "29": "قل: هو الرحمن آمنا به وصدقنا رسالته وعليه وحده توكلنا، فستعلمون عند معاينة الحق من هو في ضلال بيّن منا ومنكم.",
      "30": "قل: أرأيتم إن غار ماؤكم وذهب عميقاً في بطن الأرض لا تصل إليه الدلاء، فمن غير الله يقدر أن يأتيكم بماء عذب جارٍ وسهل التناول؟"
    }
  }
}