    "surahName": "الحاقة",
    "juz": 29,
    "theme": "أمر ملائكة العذاب بأخذ المجرم وتقييده بالأغلال وإلقائه في الجحيم وسلكه في سلسلة سبعين ذراعاً لعدم إيمانه بالله العظيم",
    "ayahMeanings": {
      "30": "يقول الله لزبانية النار: خذوا هذا الكافر المجرم واجمعوا يديه إلى عنقه بالأغلال المقيدة.",
      "31": "ثم أدخلوه نار الجحيم العظمى ليقاسي حرها وشواءها.",
      "32": "ثم في سلسلة من حديد جهنم طولها سبعون ذراعاً فأدخلوه فيها والووها عليه ليشتد عذابه.",
      "33": "إن هذا المجرم كان في الدنيا لا يصدق ولا يقر بوحدانية الله العظيم ولا يعبده."
    }
  }
