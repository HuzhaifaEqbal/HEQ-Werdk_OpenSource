  "tutorContext": {
    "surahName": "القلم",
    "juz": 29,
    "theme": "إثبات جنات النعيم للمتقين وإنكار تسويتهم بالمجرمين في الجزاء، وتحدي المشركين بكتاب أو حجة تنصر باطلهم",
    "ayahMeanings": {
      "34": "إن للمتقين الذين خافوا ربهم عند خالقهم جنات النعيم المقيم.",
      "35": "أفنجعل أهل الطاعة والاستسلام لله كأهل الكفر والإجرام والمعاصي؟ كلا لا يستوون.",
      "36": "أي شيء أصاب عقولكم؟ كيف تحكمون هذا الحكم الجائر الباطل بتسوية الأبرار بالفجار؟",
      "37": "أم لكم كتاب سماوي منزل من عند الله تقرؤون فيه وتدرسونه يؤيد زعمكم؟",
      "38": "إن لكم في ذلك الكتاب المزعوم ما تختارونه وتشتهونه لأنفسكم؟"
    }
  }
