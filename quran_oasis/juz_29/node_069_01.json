  "tutorContext": {
    "surahName": "الحاقة",
    "juz": 29,
    "theme": "تهويل يوم القيامة الثابت الوقوع، وتذكير قريش بهلاك ثمود بالصيحة الطاغية وهلاك عاد بالريح الصرصر العاتية",
    "ayahMeanings": {
      "1": "الساعة الواجبة الوقوع التي يحق فيها الجزاء والحساب وتتحقق فيها المواعيد.",
      "2": "أي شيء هي هذه الحاقة في شدتها وهولها وعظمتها؟",
      "3": "وما أعلمك يا محمد ما كنه الحاقة وأهوالها الهائلة؟",
      "4": "كذبت قبيلتا ثمود وعاد بالقيامة التي تقرع القلوب بأفزاعها.",
      "5": "فأما قوم ثمود فأُهلكوا بالصيحة المجاوزة للحد في الشدة والصوت حتى قطعت قلوبهم.",
      "6": "وأما قوم عاد فأُهلكوا بريح باردة شديدة الهبوب والصوت عتت على خزانها وتجاوزت الحد."
    }
  }
