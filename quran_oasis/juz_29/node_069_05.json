  "tutorContext": {
    "surahName": "الحاقة",
    "juz": 29,
    "theme": "ندم صاحب الشمال وخزيه حين يؤتى كتابه بشماله، وتمنيه الموت الأبدي وضياع ماله وسلطانه وحجته",
    "ayahMeanings": {
      "25": "وأما من أُعطي كتاب سيئاته بشماله، فيقول متجرعاً الحسرة والخزي: يا ليتني لم أُعط كتابي.",
      "26": "ولم أعلم ما هو حسابي ولا ما أعددت لنفسي من الهلاك.",
      "27": "يا ليت موتتي في الدنيا كانت هي الفاصلة القاطعة لأمري ولم أُبعث بعدها أبداً.",
      "28": "ما دفع عني عذاب الله مالي الذي جمعته في الدنيا ولم ينفعني شيء منه.",
      "29": "ذهب عني وسقط جاهي وقوتي وسلطاني وحجتي فلم يبق لي ناصر ولا عذر."
    }
  }
