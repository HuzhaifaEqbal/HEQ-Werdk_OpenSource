  "tutorContext": {
    "surahName": "القيامة",
    "juz": 29,
    "theme": "ذم إيثار الحياة الفانية على الدار الباقية، ومقارنة مشهد وجوه المؤمنين الناضرة برؤية ربها بوجوه الكافرين الباسرة المتوقعة للهلاك.",
    "ayahMeanings": {
      "20": "كلا ليس الأمر كما زعمتم، بل أنتم تحبون الحياة الدنيا وزينتها العاجلة.",
      "21": "وتتركون الدار الآخرة ونعيمها الدائم المقيم.",
      "22": "وجوه المؤمنين في ذلك اليوم حسنة مشرقة نضرة بالنعيم والسرور.",
      "23": "تنظر إلى وجه ربها وخالقها وتتمتع برؤيته سبحانه وتعالى.",
      "24": "ووجوه الكفار الفجار في ذلك اليوم كالحة عابسة ومظلمة.",
      "25": "تتوقع وتتيقن أن ينزل بها داهية ومصيبة عظيمة تقصم فقرات الظهر."
    }
  }
}