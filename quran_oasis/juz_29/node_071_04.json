  "tutorContext": {
    "surahName": "نوح",
    "juz": 29,
    "theme": "الاستدلال على قدرة الله بخلق سبع سماوات متطابقة وجعل القمر نوراً والشمس سراجاً، وبسط الأرض وتمهيد سبلها الواسعة",
    "ayahMeanings": {
      "15": "ألم تنظروا وتتفكروا كيف بنى الله سبع سماوات طبقات متطابقة بعضها فوق بعض بإتقان وعظمة؟",
      "16": "وجعل القمر في سماء الدنيا نوراً يضيء الليل، وجعل الشمس سراجاً وهاجاً مضيئاً حاراً بالنهار.",
      "17": "والله أنشأ أباكم آدم من تراب الأرض ثم تناسلتم منها فنبتُّم نباتاً.",
      "18": "ثم يميتكم فيعيدكم إلى باطن الأرض بعد الموت، ثم يخرجكم منها أحياء يوم البعث والنشور.",
      "19": "والله جعل لكم الأرض ممهدة منبسطة كالبساط لتستقروا عليها وتسكنوها.",
      "20": "لتسلكوا فيها طرقاً واسعة فسيحة تبتغون بها معايشكم وأسفاركم."
    }
  }
}