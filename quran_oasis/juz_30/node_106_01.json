  "tutorContext": {
    "surahName": "قريش",
    "juz": 30,
    "theme": "امتنان الله على قريش بتيسير رحلتي الشتاء والصيف والأمن من الخوف وإطعامهم في الحرم، ودعوتهم لإفراد الله بالعبادة",
    "ayahMeanings": {
      "1": "اعجبوا لإلف قريش واعتيادهم وتأليف قلوبهم وجمع كلمتهم.",
      "2": "اعتيادهم رحلة الشتاء إلى اليمن للتجارة ورحلة الصيف إلى الشام في أمن وأمان.",
      "3": "فليعبدوا الله وحده رب هذا البيت الحرام الذي شرفهم به وعصمهم به.",
      "4": "الذي رزقهم الطعام وساق إليهم الأرزاق من كل فج ودفع عنهم غائلة الجوع، وآمنهم من مخاوف الطريق وغارات العدو."
    }
  }
