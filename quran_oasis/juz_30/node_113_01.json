    "juz": 30,
    "theme": "الاعتصام والتحصن بالله رب الفلق والصبح من شر كل مؤذ ومن شرور الليل والسواحر والحاسدين",
    "ayahMeanings": {
      "1": "قل: أعتصم وألتجئ برب الصبح وفالق الإصباح.",
      "2": "من شر جميع ما خلق من الإنس والجن والدواب وسائر المخلوقات.",
      "3": "ومن شر الليل الشديد الظلمة إذا دخل وغمر الكون بما فيه من الشرور.",
      "4": "ومن شر الساحرات اللاتي ينفثن وينفخن في عقد الخيوط لإيقاع السحر والأذى.",
      "5": "ومن شر الشخص الحاسد الذي يتمنى زوال النعمة عن غيره ويسعى في الإضرار به عند حسده."
    }
  }
