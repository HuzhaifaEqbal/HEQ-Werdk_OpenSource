  "tutorContext": {
    "surahName": "الماعون",
    "juz": 30,
    "theme": "ذم أخلاق المنافقين والمكذبين بالدين: قسوة على اليتيم، وبخل بالطعام، وتهاون في الصلاة ورياء فيها، ومنع العون اليسير",
    "ayahMeanings": {
      "1": "هل عرفت الذي يكذب بالجزاء والحساب في الدار الآخرة؟",
      "2": "فذلك الذي يدفع اليتيم دفعاً عنيفاً بظلم وقهر ويمنعه حقه.",
      "3": "ولا يحث نفسه ولا غيره على إطعام المحتاج والمسكين لبخله وقسوة قلبه.",
      "4": "فهلاك وعذاب شديد لأولئك الذين يصلون مظهراً.",
      "5": "الذين هم عن صلاتهم لاهون يؤخرونها عن وقتها ولا يقيمون أركانها وخشوعها.",
      "6": "الذين يتظاهرون بأعمالهم ليرى الناس صلاحهم طلباً للمحمدة.",
      "7": "ويمنعون إعارة ما لا ضرر في إعارته كالفأس والقدر والدلو والملح وسائر ما يتعاونه الجيران."
    }
  }
