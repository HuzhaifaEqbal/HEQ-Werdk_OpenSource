  "tutorContext": {
    "surahName": "المسد",
    "juz": 30,
    "theme": "وعيد أبي لهب وامرأته بالهلاك التام ونار جهنم جزاء صدهما عن سبيل الله وإيذائهما لرسول الله ﷺ",
    "ayahMeanings": {
      "1": "خسرت يدا أبي لهب وهلك وشقي، وقد تحقق هلاكه وخسرانه بالفعل.",
      "2": "ما دفع عنه عذاب الله ماله الذي جمعه ولا كسبه وولده.",
      "3": "سيدخل ناراً ذات لهب عظيم يشتعل ويتأجج صلاؤها.",
      "4": "وستدخل معه امرأته أم جميل التي كانت تحمل الشوك وتلقيه في طريق النبي ﷺ وتوقد نار العداوة بالنميمة.",
      "5": "في عنقها حبل محكم الفتل من ليف جهنم أو حديدها تُقاد به وتُعذب."
    }
  }
}