  "tutorContext": {
    "surahName": "الإخلاص",
    "juz": 30,
    "theme": "بيان صفة الله تعالى وتوحيده الخالص: الأحد الصمد المنزه عن الولد والوالد والمكافئ والمثيل",
    "ayahMeanings": {
      "1": "قل يا محمد لمن سألك عن صفة ربك: هو الله المنفرد بالألوهية والربوبية والأسماء والصفات لا نظير له.",
      "2": "الله السيد الكامل في سؤدده المقصود وحده في الحوائج والرغائب وتفتقر إليه الخلائق بأسرها.",
      "3": "ليس له ولد ولا والد لكمال غناه وقدمه وأزليته.",
      "4": "ولم يكن له مماثل ولا مكافئ ولا نظير في ذاته وصفاته وأفعاله."
    }
  }
