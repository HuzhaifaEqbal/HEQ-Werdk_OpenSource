  "tutorContext": {
    "surahName": "الهمزة",
    "juz": 30,
    "theme": "وعيد شديد للطعّان في الناس العياب لهم، الذي يشغله جمع المال عن الآخرة فيلقى في الحطمة",
    "ayahMeanings": {
      "1": "هلاك ودمار وعذاب شديد لكل عياب طعان في أعراض الناس بالقول والإشارة.",
      "2": "الذي همه جمع الأموال وإحصاؤها والتباهي بها دون إنفاقها في حقها.",
      "3": "يظن لجهله وغروره أن ماله سيخلده في الدنيا ويدفع عنه الموت.",
      "4": "ليس الأمر كما يحسب، ليُقذفَنَّ ويُطرحَنَّ في نار جهنم التي تحطم كل ما يلقى فيها.",
      "5": "وما أعلمك يا محمد ما هذه النار الحاطمة لكل شيء؟"
    }
  }
