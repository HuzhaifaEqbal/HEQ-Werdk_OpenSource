  "tutorContext": {
    "surahName": "العصر",
    "juz": 30,
    "theme": "بيان خسارة جنس الإنسان إلا من حقق أركان الفلاح الأربعة: الإيمان، والعمل الصالح، والتواصي بالحق، والتواصي بالصبر",
    "ayahMeanings": {
      "1": "أقسم الله تعالى بالدهر والزمان لما فيه من العبر والدلالة على قدرة الصانع.",
      "2": "إن كل إنسان لفي خسران وهلاك ونقصان في تجارته وسعيه في الدنيا.",
      "3": "إلا من اتصف بأربع خلال: آمن بالله ورسله، وعمل الصالحات، ووصى غيره باتباع الحق، ووصى بالصبر على طاعة الله وعن معصيته وعلى أقداره."
    }
  }
