  "tutorContext": {
    "surahName": "الحشر",
    "juz": 28,
    "theme": "تسبيح ما في السماوات والأرض لله العزيز الحكيم، وقص نبأ إجلاء يهود بني النضير من ديارهم وقذف الرعب في قلوبهم وأمر أولي الأبصار بالاعتبار.",
    "ayahMeanings": {
      "1": "نزّه ومجّد الله وعظّمه كل ما في السماوات وما في الأرض، وهو العزيز الغالب في ملكه، الحكيم في تدبيره وشرعه.",
      "2": "هو الذي أخرج كفار يهود بني النضير من ديارهم وحصونهم بالمدينة لأول إخراج وجلاء إلى الشام، ما ظننتم أن يخرجوا لقوتهم، وظنوا أن حصونهم مانعتهم من بأس الله فأتاهم عذاب الله من حيث لم يحتسبوا وقذف في قلوبهم الرعب يخربون بيوتهم بأيديهم وأيدي المؤمنين فاعتبروا يا أصحاب العقول والبصائر.",
      "3": "ولولا أن الله قضى وكتب عليهم مفارقة الأوطان والجلاء لعذبهم في الدنيا بالقتل والسبي، ولهم في الدار الآخرة عذاب النار.",
      "4": "ذلك الجزاء والعقاب بسبب أنهم عادوا وخالفوا أمر الله ورسوله، ومن يشاقق الله ويعاده فإن الله شديد العقاب له."
    }
  }
}