  "tutorContext": {
    "surahName": "الصف",
    "juz": 28,
    "theme": "الدلالة على أعظم تجارة رابحة تنجي من العذاب الأليم بالإيمان والجهاد بالمال والنفس، وجزاؤها بمغفرة الذنوب ومساكن عدن الطيبة والنصر والفتح القريب في الدنيا.",
    "ayahMeanings": {
      "10": "يا أيها الذين آمنوا هل أدلكم وأرشدكم إلى صفقة وتجارة عظيمة تخلصكم وتنجيكم من عذاب أليم موجع؟",
      "11": "تداومون على الإيمان بالله ورسوله وتجاهدون في سبيل الله بأموالكم وأنفسكم، ذلك العمل خير لكم وأنفع إن كنتم تعلمون فضل ذلك.",
      "12": "إن فعلتم ذلك يغفر الله لكم ذنوبكم ويدخلكم جنات تجري من تحت قصورها الأنهار ومساكن وقصوراً طيبة في جنات إقامة دائمة، ذلك هو الفلاح العظيم.",
      "13": "ولكم نعمة وفضيلة أخرى تحبونها عاجلة في الدنيا: نصر مؤزر من الله وفتح قريب للبلاد وقلوب العباد، وبشر المؤمنين الصادقين بهذا الفضل."
    }
  }
}