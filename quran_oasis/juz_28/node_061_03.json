  "tutorContext": {
    "surahName": "الصف",
    "juz": 28,
    "theme": "بيان ظلم من افترى على الله الكذب وهو يدعى إلى الإسلام، ومحاولة الكفار العابثة إطفاء نور الله بأفواههم ووعد الله بإتمام نوره وإظهار دينه الحق على سائر الأديان.",
    "ayahMeanings": {
      "7": "لا أحد أشد ظلماً وعدواناً ممن اختلق على الله الكذب وجعل له شركاء وهو يُدعى إلى الدخول في دين الإسلام الحق، والله لا يوفق القوم الظالمين للرشاد.",
      "8": "يريد الكفار بمكرهم وشبهاتهم الباطلة أن يطفئوا نور الإسلام والقرآن بأفواههم، والله متم نوره ومظهر دينه ولو كره الكافرون.",
      "9": "هو الذي أرسل رسوله محمداً ﷺ بالبيان الواضح ودين الحق ليعليه ويظهره على جميع الأديان والملل ولو كره المشركون ذلك."
    }
  }
