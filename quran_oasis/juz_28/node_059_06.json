  "tutorContext": {
    "surahName": "الحشر",
    "juz": 28,
    "theme": "الأمر بتقوى الله ومحاسبة النفس على ما قدمته ليوم القيامة، والتحذير من التشبه بمن نسوا الله فأنساهم أنفسهم، وبيان الفارق العظيم بين أصحاب النار وأصحاب الجنة الفائزين.",
    "ayahMeanings": {
      "18": "يا أيها الذين آمنوا اتقوا الله بامتثال أوامره واجتناب نواهيه، ولتنظر كل نفس وتتفكر فيما ادخرت وقدمت من الأعمال الصالحة ليوم القيامة، واتقوا الله إن الله خبير بجميع أعمالكم.",
      "19": "ولا تكونوا كالكفار والمنافقين الذين تركوا طاعة الله ونسوا حقه، فجازاهم بأن أنساهم ما فيه صلاح أنفسهم ونجاتها، أولئك هم الخارجون عن طاعة الله.",
      "20": "لا يتساوى في ميزان العدل والجزاء أهل النار المعذبون وأهل الجنة المنعمون، أصحاب الجنة وحدهم هم الفائزون برضوان الله والنعيم المقيم."
    }
  }
