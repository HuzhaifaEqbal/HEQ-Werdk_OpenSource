  "tutorContext": {
    "surahName": "الجمعة",
    "juz": 28,
    "theme": "أمر المؤمنين بالسعي الحثيث لحضور صلاة الجمعة وترك البيع والشواغل الدنيوية، وإباحة الابتغاء من فضل الله بعد الصلاة، وتوبيخ الانفضاض إلى عروض التجارة وترك النبي ﷺ قائماً.",
    "ayahMeanings": {
      "9": "يا أيها الذين آمنوا إذا أذّن المؤذن لصلاة الجمعة فامضوا وسارعوا إلى استماع الخطبة والصلاة، واتركوا البيع والشراء وسائر المعاملات، ذلكم السعي والترك خير لكم وأنفع إن كنتم تفقهون مصالحكم.",
      "10": "فإذا فُرغ من صلاة الجمعة فانتشروا في الأرض لابتغاء الرزق والتجارة الحلال من فضل الله، واذكروا الله ذكراً كثيراً في كل أحوالكم لتفوزوا بخير الدنيا والآخرة.",
      "11": "وإذا رأى بعضهم تجارة قادمة أو لهواً ولعباً تفرقوا مسرعين إليها وتركوك يا محمد قائماً على المنبر تخطب، قل لهم: ما عند الله من الثواب والنعيم المقيم خير وأبقى من اللهو والتجارة العاجلة، والله خير الرازقين."
    }
  }
}