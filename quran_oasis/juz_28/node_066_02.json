  "tutorContext": {
    "surahName": "التحريم",
    "juz": 28,
    "theme": "أمر المؤمنين بوقاية أنفسهم وأهليهم من نار وقودها الناس والحجارة عليها ملائكة غلاظ شداد، وتوبيخ الكفار بحرمان المعذرة، والحث على التوبة النصوح المورثة للنور التام يوم القيامة.",
    "ayahMeanings": {
      "6": "يا أيها الذين آمنوا احموا أنفسكم وأهليكم من نار عظيمة حطبها الكفار والحجارة، يقوم على تعذيب أهلها ملائكة أقوياء قساة لا يعصون الله ما أمرهم ويفعلون ما يؤمرون به فوراً.",
      "7": "يقال للكفار يوم القيامة: يا أيها الذين كفروا لا تعتذروا اليوم فإنه لا عذر لكم، إنما تجزون اليوم وفاق ما كنتم تعملون في الدنيا من الكفر والسيئات.",
      "8": "يا أيها الذين آمنوا توبوا إلى الله توبة صادقة خالصة نصوحاً لا رجوع بعدها للذنب، عسى ربكم أن يمحو عنكم سيئاتكم ويدخلكم جنات تجري من تحتها الأنهار يوم لا يخزي الله النبي والذين آمنوا معه، نورهم يسعى بين أيديهم وبأيمانهم يقولون: ربنا أتمم لنا نورنا واغفر لنا إنك على كل شيء قدير."
    }
  }
}
