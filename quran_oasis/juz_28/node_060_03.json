  "tutorContext": {
    "surahName": "الممتحنة",
    "juz": 28,
    "theme": "بشارة الله بتبدل العداوة إلى مودة بإسلام أهل مكة، وبيان تشريع البر والعدل مع الكفار المسالمين الذين لم يقاتلوا، وحرمة موالاة المحاربين المخرجين من الديار.",
    "ayahMeanings": {
      "7": "عسى الله أن يجعل بينكم وبين الذين عاديتموهم من كفار مكة مودة ومحبة بهدايتهم للإسلام، والله قدير على تقليب القلوب، والله غفور لمن تاب رحيم به.",
      "8": "لا ينهاكم الله عن الكفار الذين لم يقاتلوكم بسبب الدين ولم يخرجوكم من دياركم أن تحسنوا إليهم وتعدلوا معهم؛ إن الله يحب العادلين المنصفين.",
      "9": "إنما ينهاكم الله عن موالاة الذين قاتلوكم لأجل دينكم وأخرجوكم من دياركم وعاونوا أعداءكم على إخراجكم، ومن يتخذهم أولياء فأولئك هم الظالمون لأنفسهم ولدينهم."
    }
  }
