  "tutorContext": {
    "surahName": "الأعراف",
    "juz": 8,
    "theme": "تقرير توحيد الله وآيات قدرته، ودعوة المكذبين للنظر في مصائر الأمم، وبيان أصول الإيمان والبعث والولاية لله.",
    "ayahMeanings": {
      "13": "قال الله لإبليس: فاهبط من الجنة، فما يصح لك أن تتكبر فيها، فاخرج من الجنة، إنك من الذليلين الحقيرين.",
      "14": "قال إبليس لله -جل وعلا- حينما يئس من رحمته: أمهلني إلى يوم البعث; وذلك لأتمكن من إغواء مَن أقدر عليه من بني آدم.",
      "15": "قال الله تعالى: إنك ممن كتبتُ عليهم تأخير الأجل إلى النفخة الأولى في القرن، إذ يموت الخلق كلهم.",
      "16": "قال إبليس لعنه الله: فبسبب ما أضللتني لأجتهدنَّ في إغواء بني آدم عن طريقك القويم، ولأصدَّنَّهم عن الإسلام الذي فطرتهم عليه.",
      "17": "ثم لآتينَّهم من جميع الجهات والجوانب، فأصدهم عن الحق، وأُحسِّن لهم الباطل، وأرغبهم في الدنيا، وأشككهم في الآخرة، ولا تجد أكثر بني آدم شاكرين لك نعمتك.",
      "18": "قال الله تعالى لإبليس: اخرج من الجنة ممقوتًا مطرودًا، لأملأنَّ جهنم منك وممن تبعك من بني آدم أجمعين."
    }
  }
