  "tutorContext": {
    "surahName": "الواقعة",
    "juz": 27,
    "theme": "إقامة الحجة بأربعة براهين كبرى على قدرة الله على البعث: خلق النطفة، إنبات الزرع، إنزال ماء المطر، وإيقاد النار، والأمر بالتسبيح.",
    "ayahMeanings": {
      "57": "نحن خلقناكم أول مرة من العدم، فهل تصدقون بالبعث والإعادة؟",
      "58": "أفرأيتم المني الذي تقذفونه في أرحام النساء؟",
      "59": "أأنتم تخلقون منه بشراً سوياً، أم نحن الخالقون المتفردون بالإيجاد؟",
      "60": "نحن قدرنا وقضينا بينكم الموت في آجال معلومة، وما نحن بعاجزين ولا مسبوقين.",
      "61": "على أن نبدل خلقاً غيركم ونعيدكم في خلق وصور لا تعلمونها.",
      "62": "ولقد علمتم خلقكم الأول، فهلا تذكرتم أن القادر على البدء قادر على الإعادة؟",
      "63": "أفرأيتم الحب الذي تحرثون له الأرض وتلقونه في التراب؟",
      "64": "أأنتم تنبتونه وتخرجون زرعه وسنابله، أم نحن الزارعون المنبتون؟",
      "65": "لو نشاء لجعلنا ذلك الزرع هشيماً حطاماً يابساً قبل إدراكه، فظلتم تتعجبون وتتحسرون.",
      "66": "قائلين: إنا لخاسرون مغرمون ما أنفقنا بلا فائدة.",
      "67": "بل نحن محرومون الرزق والخير.",
      "68": "أفرأيتم الماء العذب البارد الذي تشربونه لحياتكم؟",
      "69": "أأنتم أنزلتموه من السحاب الأبيض (المزن)، أم نحن المنزلون له برحمتنا؟",
      "70": "لو نشاء لجعلنا ذلك المطر شديد الملوحة والمرارة لا يُنتفع به، فهلا تشكرون الله على عذوبته؟",
      "71": "أفرأيتم النار التي توقدونها وتستضيئون بها وتصلون طعامكم؟",
      "72": "أأنتم أنشأتم شجرتها الخضراء التي توقد منها (كالمرخ والعفار)، أم نحن المنشئون؟",
      "73": "نحن جعلنا هذه النار تذكرة بنار جهنم الكبرى، ومنفعة ومتاعاً للمسافرين والمحتاجين.",
      "74": "فنزه اسم ربك العظيم وقدسه عن كل نقص وعجز."
    }
  }
}