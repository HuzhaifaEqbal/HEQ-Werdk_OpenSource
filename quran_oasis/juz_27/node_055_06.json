  "tutorContext": {
    "surahName": "الرحمن",
    "juz": 27,
    "theme": "نعيم الجنتين الأخريين لأهل اليمين، شدة خضرتهما وعيونهما النضاختين، والحور المقصورات في الخيام، وخاتمة السورة بالثناء على ذي الجلال والإكرام.",
    "ayahMeanings": {
      "62": "ومن دون الجنتين السابقتين جنتان أخريان أدنى منهما فضلاً لأصحاب اليمين.",
      "63": "فبأي آلاء ربكما تكذبان؟",
      "64": "سوداوان من شدة الخضرة والري والنعيم.",
      "65": "فبأي آلاء ربكما تكذبان؟",
      "66": "فيهما عينان نضاختان تفيضان بالماء ولا تنقطعان.",
      "67": "فبأي آلاء ربكما تكذبان؟",
      "68": "فيهما أنواع الفواكه والنخيل والرمان.",
      "69": "فبأي آلاء ربكما تكذبان؟",
      "70": "فيهن نساء طيبات الأخلاق حسان الوجوه.",
      "71": "فبأي آلاء ربكما تكذبان؟",
      "72": "حور حسان محبوسات مستورات في خيام اللؤلؤ صيانة وكرامة.",
      "73": "فبأي آلاء ربكما تكذبان؟",
      "74": "أبكار لم يمسهن قبلهن إنس ولا جان.",
      "75": "فبأي آلاء ربكما تكذبان؟",
      "76": "متكئين على وسائد وبسط خضر وفرش حسان الصنعة.",
      "77": "فبأي آلاء ربكما تكذبان؟",
      "78": "تكاثرت بركات اسم ربك وتعالت عظمته، ذي الجلال والعظمة والإكرام لأوليائه."
    }
  }
