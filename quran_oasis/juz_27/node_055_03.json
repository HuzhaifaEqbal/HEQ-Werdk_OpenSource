  "tutorContext": {
    "surahName": "الرحمن",
    "juz": 27,
    "theme": "حقيقة فناء جميع الخلائق وبقاء وجه الله ذي الجلال والإكرام، وتحدي الثقلين بالنفوذ من أقطار السماوات والأرض.",
    "ayahMeanings": {
      "26": "كل من على وجه الأرض من الخلائق فانٍ وهالك لا محالة.",
      "27": "ويبقى وجه ربك الحي القيوم ذو العظمة والجلال والفضل والإكرام لأوليائه.",
      "28": "فبأي آلاء ربكما تكذبان؟",
      "29": "يسأله كل من في السماوات والأرض حاجاتهم ومغفرتهم، كل يوم هو في شأن يغفر ذنباً ويفرج كرباً ويعز ويذل.",
      "30": "فبأي آلاء ربكما تكذبان؟",
      "31": "سنقصد لحسابكم وجزائكم أيها الثقلان (الإنس والجن).",
      "32": "فبأي آلاء ربكما تكذبان؟",
      "33": "يا معشر الجن والإنس إن قدرتم على الهرب والخروج من أطراف السماوات والأرض فهربوا، ولن تستطيعوا إلا بقوة وأمر من الله ولا تملكونه.",
      "34": "فبأي آلاء ربكما تكذبان؟",
      "35": "يرسل عليكما عند محاولة الهرب لهب خالص من النار ودخان حار أو نحاس مذاب فلا تقدران على التناصر.",
      "36": "فبأي آلاء ربكما تكذبان؟"
    }
  }
}