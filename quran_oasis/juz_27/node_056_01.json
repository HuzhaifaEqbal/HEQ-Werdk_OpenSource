  "tutorContext": {
    "surahName": "الواقعة",
    "juz": 27,
    "theme": "افتتاح السورة بوصف أهوال يوم القيامة وخفضها لأعداء الله ورفعها لأوليائه وانقسام الخلائق إلى ثلاثة أصناف.",
    "ayahMeanings": {
      "1": "إذا قامت القيامة وحان وقوعها المحتوم الذي لا شك فيه.",
      "2": "ليس لوقوعها نفس تكذب بها أو تنكر قيامها.",
      "3": "خافضة لأعداء الله في أسفل النار، رافعة لأوليائه في أعلى درجات الجنان.",
      "4": "إذا حُرّكت الأرض واضطربت تحريكاً ورجّاً شديداً.",
      "5": "وفُتتت الجبال الشامخة تفتيتاً حتى صارت كالدقيق المنخول.",
      "6": "فكانت غباراً متطايراً متفرقاً لا ثبات له.",
      "7": "وصرتم أيها الناس ثلاثة أصناف وأزواج متباينة.",
      "8": "فأصحاب الميمنة ما أعظم مكانتهم وأشرف شأنهم في جنات النعيم!",
      "9": "وأصحاب المشأمة ما أسوأ حالهم وأشد عذابهم في الجحيم!",
      "10": "والسابقون إلى الخيرات والطاعات في الدنيا هم السابقون إلى الدرجات العلى والكرامة."
    }
  }
}