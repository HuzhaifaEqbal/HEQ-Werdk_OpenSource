  "tutorContext": {
    "surahName": "الطور",
    "juz": 27,
    "theme": "شدة عناد المكذبين، وتثبيت النبي صلى الله عليه وسلم بوعد الحفظ الإلهي والأمر بدوام التسبيح والصبر.",
    "ayahMeanings": {
      "44": "ولو رأى هؤلاء المشركون قطعاً من السماء تسقط عليهم عذاباً لقالوا مكابرةً: هذا سحاب متراكم بعضه فوق بعض.",
      "45": "فاتركهم في غيهم حتى يلاقوا يومهم الذي فيه يهلكون بالصعقة والعذاب.",
      "46": "يوم لا ينفعهم مكرهم ولا كيدهم ولا يجدون لهم ناصراً يدفع عنهم بأس الله.",
      "47": "وإن للذين ظلموا عذاباً في الدنيا قبل عذاب القيامة ولكن أكثرهم لا يعلمون سنة الله في إمهالهم.",
      "48": "واصبر لحكم ربك وقضائه فإنك بمرأى منا وتحت رعايتنا وحفظنا التام، وسبح بحمد ربك حين تقوم إلى الصلاة أو من نومك ومجلسك.",
      "49": "ومن الليل فسبح الله بالصلاة والذكر، وعند إدبار النجوم عند صلاة الفجر."
    }
  }
}