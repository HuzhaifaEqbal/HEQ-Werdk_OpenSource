  "tutorContext": {
    "surahName": "الواقعة",
    "juz": 27,
    "theme": "القسم الإلهي بمواقع النجوم على عظمة القرآن الكريم في اللوح المحفوظ، وتحدي الإنسان عند بلوغ الروح الحلقوم، وبيان مصير الأصناف الثلاثة عند الموت وحق اليقين.",
    "ayahMeanings": {
      "75": "فأقسم بمواقع النجوم ومنازلها في السماء ومساقطها.",
      "76": "وإنه لقسم لو تعلمون قدره وعظمته لعظيم جداً.",
      "77": "إن هذا المتلو عليكم لقرآن عظيم المنفعة كريم في هدايته وبركته.",
      "78": "في كتاب مكنون مصون وهو اللوح المحفوظ.",
      "79": "لا يمسه إلا الملائكة المطهرون من الذنوب والعيوب.",
      "80": "منزل من رب العالمين كافة على قلب محمد ﷺ.",
      "81": "أفبهذا الحديث والقرآن أنتم تدهنون وتتهاونون وتداهنون؟",
      "82": "وتجعلون شكر رزقكم ونعم الله عليكم أنكم تكذبون بها؟",
      "83": "فهلا إذا بلغت الروح الحلقوم عند الموت وشارف المحتضر على الخروج.",
      "84": "وأنتم في تلك اللحظة حاضرون تنظرون إليه عاجزين عن نفعه.",
      "85": "ونحن بملائكتنا وقدرتنا أقرب إليه منكم ولكنكم لا تبصرون الملائكة.",
      "86": "فهلا إن كنتم غير محاسبين ولا مجزيين بعد الموت كما تزعمون.",
      "87": "ترجعون تلك الروح الخارجة إلى الجسد إن كنتم صادقين في إنكاركم؟",
      "88": "فأما إن كان الميت من السابقين المقربين عند الله.",
      "89": "فله راحة وسعة ورزق طيب وريحان وجنة نعيم دائم.",
      "90": "وأما إن كان الميت من أصحاب اليمين الفائزين.",
      "91": "فسَلام لك وأمان وبشرى من إخوانك أصحاب اليمين.",
      "92": "وأما إن كان الميت من المكذبين بالحق الضالين عن الهدى.",
      "93": "فضيافته ونزله ماء شديد الغليان (حميم).",
      "94": "وإصلاء نار جهنم ومقاساة لهيبها.",
      "95": "إن هذا الذي فُصّل في هذه السورة لهو حق اليقين الثابت الصادق الذي لا مرية فيه.",
      "96": "فسبح ونزه اسم ربك العظيم عن كل نقص وسوء."
    }
  }
}