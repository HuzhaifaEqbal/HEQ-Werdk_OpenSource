  "tutorContext": {
    "surahName": "الطور",
    "juz": 27,
    "theme": "نعيم أهل الجنة من المتقين وإكرامهم بإلحاق ذرياتهم بهم في الدرجات العلى وخدمة الغلمان وشراب الكأس الصافي.",
    "ayahMeanings": {
      "17": "إن الذين اتقوا الله في بساتين ونعيم عظيم مقيم.",
      "18": "متلذذين فرحين بما تفضل به ربهم ونجاهم من عذاب جهنم.",
      "19": "يقال لهم: كلوا واشربوا هنيئاً سالماً من كل أذى جزاء أعمالكم الصالحة.",
      "20": "متكئين على سرر مصفوفة متقابلة، وزوجناهم بحور حسان واسعات الأعين.",
      "21": "والذين آمنوا واتبعتهم ذرياتهم بإيمان ألحقنا بهم ذرياتهم في درجاتهم تكرمة لهم وما نقصنا الآباء من أجرهم شيئاً.",
      "22": "وأمددناهم في الجنة بفواكه ولحوم طيبة مما يشتهون ويتمنون.",
      "23": "يتعاطون ويتناولون بينهم كؤوس الخمر اللذيذ لا لغو فيها ولا فحش ولا إثم.",
      "24": "ويطوف عليهم لخدمتهم فتيان صغار في غاية الجمال والبهاء كأنهم اللؤلؤ المحفوظ في صدفه."
    }
  }
}