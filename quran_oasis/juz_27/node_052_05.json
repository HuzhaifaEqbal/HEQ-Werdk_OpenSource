  "tutorContext": {
    "surahName": "الطور",
    "juz": 27,
    "theme": "سلسلة من التساؤلات العقلية المفحمة التي تقطع حجج المشركين وتثبت تفرد الله بالخلق والربوبية والتدبير.",
    "ayahMeanings": {
      "35": "أم خُلقوا من غير خالق أوجدهم، أم هم الذين خلقوا أنفسهم؟ وكلا الأمرين مستحيل عقلاً.",
      "36": "أم خلقوا السماوات والأرض البديعة؟ بل هم قوم لا يوقنون بالحق ولا يستعملون عقولهم.",
      "37": "أم عندهم خزائن رحمة ربك ورزقه يدبرونها كيف شاؤوا، أم هم المتسلطون القاهرون للكون؟",
      "38": "أم لهم مرقاة وسُلم إلى السماء يستمعون به أخبار الغيب؟ فليأت مستمعهم بحجة وبرهان مبين.",
      "39": "أم ينسبون لله البنات بزعمهم أن الملائكة بنات الله ويختارون لأنفسهم البنين؟ تعالى الله عن ذلك علواً كبيراً.",
      "40": "أم تسألهم يا محمد أجراً ومالاً على إبلاغ الرسالة فهم من غرامته مثقلون بالعجز عن دفعه؟",
      "41": "أم عندهم علم الغيب المحجوب فهم يكتبون منه ما يشاؤون ويحكمون به؟",
      "42": "أم يريدون المكر بك والخديعة؟ فالذين كفروا هم الذين يقع عليهم المكر والخسران.",
      "43": "أم لهم إله غير الله ينصرهم؟ تنزه الله وتقدس عما يشركون به من الأصنام والأنداد."
    }
  }
}