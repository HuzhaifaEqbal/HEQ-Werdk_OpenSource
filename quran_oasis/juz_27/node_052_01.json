  "tutorContext": {
    "surahName": "الطور",
    "juz": 27,
    "theme": "أقسام ربانية بالطور والبيت المعمور على أن عذاب الكافرين واقع لا محالة عند اضطراب السماء وسير الجبال.",
    "ayahMeanings": {
      "1": "أقسم الله بجبل الطور الذي كلم الله عليه موسى تكليماً.",
      "2": "وبكتاب مسطور مكتوب بانتظام وإحكام (القرآن أو اللوح المحفوظ).",
      "3": "في جلد رقيق منشور ومبسوط للقراءة والعلم.",
      "4": "وبالبيت المعمور في السماء السابعة الذي يدخله كل يوم سبعون ألف ملك لا يعودون إليه.",
      "5": "وبالسقف المرفوع وهو سماء الدنيا المحفوظة بقدرة الله.",
      "6": "وبالبحر المسجور الموقد ناراً يوم القيامة أو المملوء ماءً.",
      "7": "إن عذاب ربك بالكفار لواقع متحقق لا شك فيه.",
      "8": "ليس لذلك العذاب من دافع يدفعه أو يمنعه عنهم.",
      "9": "يوم تضطرب السماء وتتحرك حركة سريعة هائلة.",
      "10": "وتسير الجبال عن أماكنها وتتفتت بعد ثبوتها ورسوخها."
    }
  }
}