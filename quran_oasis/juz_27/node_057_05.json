  "tutorContext": {
    "surahName": "الحديد",
    "juz": 27,
    "theme": "عتاب المؤمنين لتلين قلوبهم لذكر الله، وضرب مثل الحياة الدنيا بالنبات الزائل، والدعوة إلى المسابقة لمغفرة الله وجنة عرضها كعرض السماء والأرض.",
    "ayahMeanings": {
      "16": "ألم يحن للمؤمنين أن تخشع قلوبهم لذكر الله والقرآن، ولا يتشبهوا بأهل الكتاب الذين طال عليهم الزمان فقست قلوبهم وكثير منهم فاسقون؟",
      "17": "اعلموا أن الله يحيي الأرض المجدبة بالمطر بعد موتها، كذلك يحيي القلوب القاسية بذكره وهدايته.",
      "18": "إن المتصدقين والمتصدقات والمقرضين لله قرضاً حسناً يضاعف لهم ثوابهم ولهم أجر كريم.",
      "19": "والذين آمنوا بالله ورسله هم الصديقون والشهداء عند ربهم لهم أجرهم ونورهم، والكافرون المكذبون أصحاب الجحيم.",
      "20": "اعلموا أنما الحياة الدنيا لعب ولهو وزينة وتفاخر وتكاثر، مثلها كمثل مطر أعجب الزراع نباته ثم يهيج ويصفر ويتحطم، والآخرة فيها عذاب شديد أو مغفرة ورضوان وما الدنيا إلا متاع الغرور.",
      "21": "سابقوا بالأعمال الصالحة إلى مغفرة من ربكم وجنة عرضها كعرض السماء والأرض أُعدت للمؤمنين، ذلك فضل الله يؤتيه من يشاء."
    }
  }
