  "tutorContext": {
    "surahName": "الطور",
    "juz": 27,
    "theme": "بيان سوء عاقبة الخائضين في الباطل ودفعهم بعنف إلى جهنم وتبكيتهم على تكذيبهم بالحق.",
    "ayahMeanings": {
      "11": "فهلاك وعذاب شديد في ذلك اليوم لكل من كذب بلقاء الله ووعده.",
      "12": "الذين هم في باطل وخوض وكذب يلعبون ويلهون عن الحق.",
      "13": "يوم يدفعون ويُساقون بعنف وإهانة وغلظة إلى نار جهنم.",
      "14": "يقال لهم تقريعاً: هذه هي النار التي كنتم في الدنيا تكذبون بها وتنكرونها.",
      "15": "أفهذا العذاب الذي ترونه عياناً سحر وخيال، أم أنتم كنتم عمياً لا تبصرون؟",
      "16": "ادخلوها وقاسوا حرها، فاصبروا على لهيبها أو لا تصبروا فسواء عليكم، إنما تجزون ما كنتم تعملون في الدنيا."
    }
  }
