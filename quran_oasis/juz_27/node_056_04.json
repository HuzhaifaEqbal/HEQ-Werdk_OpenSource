  "tutorContext": {
    "surahName": "الواقعة",
    "juz": 27,
    "theme": "عذاب أصحاب الشمال في ريح حارة وماء مغلي ودخان أسود خانق، وأكلهم من شجر الزقوم وشربهم الحميم كالإبل العطاش (الهيم).",
    "ayahMeanings": {
      "41": "وأصحاب الشمال ما أسوأ حالهم وما أفظع مآلهم في العذاب!",
      "42": "في ريح حارة تنفذ في المسام وماء شديد الغليان والحرارة.",
      "43": "وظل من دخان أسود كالح شديد السواد والحرارة.",
      "44": "لا بارد الملمس لينفعهم، ولا كريم المنظر ليريحهم بل هو قبيح مؤذٍ.",
      "45": "إنهم كانوا في الدنيا منهمكين في الشهوات منغمسين في الترف والبطر.",
      "46": "وكانوا يصرون ويقيمون على الشرك بالله والذنب العظيم بلا توبة.",
      "47": "وكانوا يقولون استبعاداً وإنكاراً: أإذا متنا وصرنا تراباً وعظاماً نبالية أإنا لمبعوثون أحياء؟",
      "48": "أو يُبعث آباؤنا الأقدمون الذين فنوا منذ زمن بعيد؟",
      "49": "قل لهم يا محمد: إن الأولين والآخرين من لدن آدم إلى قيام الساعة.",
      "50": "لمجموعون حتماً في موعد ومكان يوم القيامة المعلوم عند الله.",
      "51": "ثم إنكم أيها الضالون عن الحق المكذبون بالبعث والرسل.",
      "52": "لآكلون يومئذ من ثمار شجر الزقوم الكريه المنظر والطعم في قعر الجحيم.",
      "53": "فمالئون منها بطونكم من شدة الجوع وعظيم البلاء.",
      "54": "فشاربون على ذلك الطعام النتن من الماء الحميم الذي يقطع الأمعاء.",
      "55": "فشاربون منه شرب الإبل العطاش التي لا تروى لداء في بطونها (الهيم).",
      "56": "هذا هو ضيافتهم ونزلهم المهين يوم الجزاء والحساب."
    }
  }
}