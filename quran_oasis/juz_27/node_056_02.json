  "tutorContext": {
    "surahName": "الواقعة",
    "juz": 27,
    "theme": "بيان نعيم السابقين المقربين في جنات النعيم على سرر منسوجة بالذهب، وخدمة الغلمان بكؤوس الخمر المنزهة، وحور عين كاللؤلؤ المكنون.",
    "ayahMeanings": {
      "11": "أولئك هم المقربون عند الله في الدرجات العالية من الجنة.",
      "12": "في بساتين النعيم الدائم المقيم.",
      "13": "جماعة كثيرة من الأمم السابقة وأوائل هذه الأمة.",
      "14": "وقليل من المتأخرين من هذه الأمة لسبق المتقدمين.",
      "15": "على سرر منسوجة بالذهب والجواهر بإحكام وبهاء.",
      "16": "متكئين عليها متقابلين وجوهاً لوجوه في مودة وأنس.",
      "17": "يطوف عليهم لخدمتهم غلمان صغار دائمون في سن الصبا والجمال لا يهرمون.",
      "18": "بأكواب لا عرى لها، وأباريق ذات خراطيم، وكؤوس من خمر جارية من عيون لا تنقطع.",
      "19": "لا تصدع رؤوسهم من شربها، ولا تذهب عقولهم بسكرها.",
      "20": "وفواكه مما يشتهون ويختارون من أطيب الثمار.",
      "21": "ولحم طير شهي مما تشتهيه أنفسهم.",
      "22": "ولهم نساء حور حسان واسعات الأعين جميلات.",
      "23": "في صفائهن وإشراقهن كاللؤلؤ المصون في صدفه.",
      "24": "كل هذا جزاءً وثواباً لهم بما كانوا يعملون من الصالحات في الدنيا.",
      "25": "لا يسمعون في الجنة كلاماً لغواً باطلاً ولا ما فيه إثم أو عيب.",
      "26": "إلا قيل سلاماً سلاماً، يسلم بعضهم على بعض وتسلم عليهم الملائكة."
    }
  }
}