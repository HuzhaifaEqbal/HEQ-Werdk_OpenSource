  "tutorContext": {
    "surahName": "الحديد",
    "juz": 27,
    "theme": "الحث على الإيمان بالله ورسوله والإنفاق مما استخلف الله العباد فيه، وتفضيل درجة من أنفق وقاتل قبل فتح مكة.",
    "ayahMeanings": {
      "7": "آمنوا بالله ورسوله وأنفقوا في سبيل الله مما جعلكم مستخلفين فيه من المال، فللذين آمنوا وأنفقوا أجر عظيم.",
      "8": "وما لكم لا تؤمنون بالله والرسول يدعوكم ليتحقق إيمانكم وقد أخذ الله ميثاقكم إن كنتم مصدقين بحق؟",
      "9": "هو الذي ينزل على عبده محمد ﷺ آيات بينات ليخرجكم من ظلمات الكفر والجهل إلى نور الإيمان، وإن الله لرؤوف رحيم بكم.",
      "10": "وما يمنعكم من الإنفاق في سبيل الله ولله وحده ميراث السماوات والأرض، لا يستوي منكم من أنفق من قبل الفتح وقاتل أولئك أعظم درجة من الذين أنفقوا من بعد وقاتلوا، وكلاً وعد الله الجنة."
    }
  }
