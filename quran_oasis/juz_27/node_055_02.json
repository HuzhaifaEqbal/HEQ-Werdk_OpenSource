  "tutorContext": {
    "surahName": "الرحمن",
    "juz": 27,
    "theme": "بيان خلق الإنسان من صلصال والجان من نار، والتقاء البحار ببرزخ إلهي واستخراج اللؤلؤ والمرجان وجريان السفن كالأعلام.",
    "ayahMeanings": {
      "14": "خلق أبا البشر آدم من طين يابس له صوت إذا نُقر كالطين المشوي بالنار.",
      "15": "وخلق أبا الجن (إبليس وذريته) من لهب خالص لا دخان فيه من النار.",
      "16": "فبأي آلاء ربكما تكذبان؟",
      "17": "هو سبحانه رب مشرقي الصيف والشتاء، ومغربي الصيف والشتاء في مسار الشمس.",
      "18": "فبأي آلاء ربكما تكذبان؟",
      "19": "أرسل البحرين العذب والملح يلتقيان ظاهراً في مجاريهما.",
      "20": "بينهما حاجز من قدرة الله لا يبغي أحدهما على الآخر فيغير صفته وخصائصه.",
      "21": "فبأي آلاء ربكما تكذبان؟",
      "22": "يخرج من البحرين اللؤلؤ الناصع والمرجان الأحمر الثمين حلية وزينة.",
      "23": "فبأي آلاء ربكما تكذبان؟",
      "24": "وله سبحانه السفن العظيمة المرفوعة الأشرعة في البحار كأنها الجبال الشاهقة (الأعلام).",
      "25": "فبأي آلاء ربكما تكذبان؟"
    }
  }
}