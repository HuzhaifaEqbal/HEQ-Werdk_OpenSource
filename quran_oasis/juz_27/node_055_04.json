  "tutorContext": {
    "surahName": "الرحمن",
    "juz": 27,
    "theme": "مشاهد يوم القيامة عند انشقاق السماء وتلونها كالدهان، وسحب المجرمين من نواصيهم وأقدامهم إلى الجحيم والحميم الآن.",
    "ayahMeanings": {
      "37": "فإذا انشقت السماء وتفطرت فصارت حمراء كالورد وتذوب كالزيت المغلي والدهان.",
      "38": "فبأي آلاء ربكما تكذبان؟",
      "39": "في ذلك الموقف لا يُسأل إنس ولا جان عن ذنبه سؤال استعلام لأن الله عليم بهم وبأعمالهم.",
      "40": "فبأي آلاء ربكما تكذبان؟",
      "41": "يُعرف المجرمون بعلاماتهم وسواد وجوههم وزرقة عيونهم، فيؤخذ بمقدمة رؤوسهم وأقدامهم ويقذفون في النار.",
      "42": "فبأي آلاء ربكما تكذبان؟",
      "43": "يقال لهم تبكيتاً: هذه جهنم التي كان يكذب بها المجرمون في الدنيا.",
      "44": "يترددون بين لهيب الجحيم وبين ماء مغلي بلغ الغاية في الحرارة.",
      "45": "فبأي آلاء ربكما تكذبان؟"
    }
  }
}