  "tutorContext": {
    "surahName": "القمر",
    "juz": 27,
    "theme": "قصة ثمود مع نبيهم صالح عليه السلام، وقسمة ماء البئر مع الناقة، وعقر قدار بن سالف لها، وهلاكهم بالصيحة.",
    "ayahMeanings": {
      "23": "كذبت قبيلة ثمود بإنذار الرسل.",
      "24": "فقالوا استكباراً: أنتبع رجلاً بشرياً منا فرداً لا عشيرة كبيرة له تعضده؟ إنا إذاً لفي ضلال وجنون.",
      "25": "أأُنزل عليه الوحي والرسالة وفُضل بها من بيننا جميعاً؟ بل هو كذاب متكبر بطر.",
      "26": "سيعلمون عند نزول العذاب غداً من هو الكذاب المتكبر البطر.",
      "27": "إنا مخرجو الناقة من الصخرة اختباراً وابتلاءً لهم، فانتظر ما يصنعون واصبر على أذاهم.",
      "28": "وأخبرهم أن ماء البئر مقسوم بينهم وبين الناقة: يوم للناقة ويوم لهم، وكل نوبة شرب يحضرها صاحبها.",
      "29": "فنادوا شقيهم قدار بن سالف فتناول السيف وعقر الناقة بجرأة وبغي.",
      "30": "فكيف كان عقابي لهم وإنذاري الذي حل بهم؟",
      "31": "إنا أرسلنا عليهم صيحة ملك واحدة فبادوا وصاروا كالشجر واليبيس الذي يجمعه صاحب الحظيرة لأغنامه فيتكسر ويداس.",
      "32": "ولقد سهلنا القرآن ويسرناه للذكر والاتعاظ، فهل من مدكر؟"
    }
  }
}