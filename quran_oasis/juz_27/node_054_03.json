  "tutorContext": {
    "surahName": "القمر",
    "juz": 27,
    "theme": "إهلاك قبيلة عاد بريح صرصر عاتية اقتلعتهم من الأرض كجذوع النخل المنقلع، وتكرار آية تيسير القرآن.",
    "ayahMeanings": {
      "18": "كذبت عاد نبيها هوداً، فانظروا كيف كان عذابي الشديد وإنذاري الصادق.",
      "19": "إنا أرسلنا عليهم ريحاً شديدة البرودة والصوت في يوم نحس وشؤم استمر عليهم حتى أبادهم.",
      "20": "تقتلع الناس من أماكنهم بشدتها فترميهم صرعى مقطوعي الرؤوس كأنهم أصول نخل منقلع من مغارسه.",
      "21": "فكيف كان عذابي لمن عصاني ونذري لمن كذب رسلي؟",
      "22": "ولقد يسرنا القرآن وسهلناه للذكر والاتعاظ، فهل من مدكر معتبر؟"
    }
  }
