  "tutorContext": {
    "surahName": "النجم",
    "juz": 27,
    "theme": "اقتراب القيامة الآزفة، وتبكيت الغافلين اللاهين عن القرآن، والأمر بالسجود والخضوع لله سبحانه (سجدة تلاوة).",
    "ayahMeanings": {
      "56": "هذا الرسول محمد ﷺ منذر لكم كالنذر السابقة التي أُرسلت إلى الأمم الخالية.",
      "57": "قربت القيامة ودنت ساعتها المؤجلة.",
      "58": "ليس لها من دون الله نفس تقدر على كشف وقتها أو رد عذابها.",
      "59": "أفمن هذا القرآن المعجز العظيم تعجبون تكذيباً وإنكاراً؟",
      "60": "وتضحكون سخرية واستهزاء ولا تبكون خشية وتأثراً بمواعظه؟",
      "61": "وأنتم لاهون غافلون معرضون في طرب وباطل.",
      "62": "فاسجدوا لله وحده خاضعين متذللين، وأفردوه بالعبادة وحده لا شريك له."
    }
  }
}