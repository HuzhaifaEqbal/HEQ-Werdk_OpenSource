  "tutorContext": {
    "surahName": "النجم",
    "juz": 27,
    "theme": "أصول العدالة الإلهية في صحف موسى وإبراهيم: لا تزر وازرة وزر أخرى، وأن سعي كل إنسان مشهود ومجزي بالكمال.",
    "ayahMeanings": {
      "33": "أفرأيت الذي تولى وأدبر عن طاعة الله والإيمان به؟",
      "34": "وأعطى قليلاً من المال ثم بخل وقطع عطيته.",
      "35": "أعنده علم الغيب فهو يرى مصيره ويحكم به في نجاته؟",
      "36": "أم لم يُخبر بما جاء في صحف موسى التوراة؟",
      "37": "وصحف إبراهيم الذي بلغ رسالات ربه ووفى بجميع أوامره وعهوده.",
      "38": "أن لا تحمل نفس مذنبة إثم نفس أخرى ووزرها.",
      "39": "وأن ليس للإنسان في ميزان نجاته إلا ثواب عمله الذي سعى فيه بنفسه.",
      "40": "وأن عمله وسعيه سيُعرض يوم القيامة ويُرى في ميزانه.",
      "41": "ثم يُجزى عليه الجزاء الأتم والأوفى بلا نقص.",
      "42": "وأن إلى ربك وحده مصير الخلائق جميعاً ومنتهى أمورهم."
    }
  }
}