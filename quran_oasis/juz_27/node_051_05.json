  "tutorContext": {
    "surahName": "الذاريات",
    "juz": 27,
    "theme": "بيان مهمة الملائكة في إنزال العذاب بقوم لوط ونجاة بيت لوط المؤمن وعبرة ديارهم لمن يخاف العذاب.",
    "ayahMeanings": {
      "31": "قال إبراهيم للملائكة: فما شأنكم والخطب العظيم الذي أُرسلتم من أجله؟",
      "32": "قالوا: إنا بُعثنا إلى قوم قد أوغلوا في الكفر والجرائم (قوم لوط).",
      "33": "لنهلكهم بحجارة مدمرة من طين متصلب أُحرقت بالنار.",
      "34": "معلمة عند ربك بعلامات خاصة أُعدت لمعاقبة المعتدين المسرفين في فواحشهم.",
      "35": "فأخرجنا من قرية قوم لوط من كان فيها من أهل الإيمان صيانةً لهم من العذاب.",
      "36": "فما وجدنا فيها سوى بيت واحد من المسلمين وهو بيت لوط وبناته إلا امرأته الخائنة.",
      "37": "وأبقينا في ديارهم المهلكة عبرة وآية واضحة للذين يخافون عذاب الله الأليم."
    }
  }
