  "tutorContext": {
    "surahName": "النجم",
    "juz": 27,
    "theme": "شروط الشفاعة الإلهية، والنهي عن تسمية الملائكة إناثاً، وبيان سعة مغفرة الله للمتقين الذين يجتنبون كبائر الذنوب.",
    "ayahMeanings": {
      "26": "وكم من ملك عظيم القدر في السماوات لا تغني شفاعتهم عند الله شيئاً إلا بعد أن يأذن الله ويرضى عن المشفوع له.",
      "27": "إن الذين ينكرون البعث يسمون الملائكة تسمية الإناث بزعمهم أنهم بنات الله.",
      "28": "وما لهم بذلك من علم وبرهان، إن يتبعون إلا الظن، وإن الظن لا يغني من الحق شيئاً.",
      "29": "فأعرض عمن تولى عن ذكر الله ولم يرد إلا التمتع بزينة الحياة الدنيا الفانية.",
      "30": "ذلك منتهى علمهم وحظهم، إن ربك هو أعلم بالضال عن سبيله وبالمهتدي إليه.",
      "31": "ولله ملك السماوات والأرض ليجزي المسيئين بعقابهم ويجزي المحسنين بالجنة والكرامة.",
      "32": "الذين يبتعدون عن كبائر الذنوب والفواحش إلا صغائر الهفوات، إن ربك واسع المغفرة، هو أعلم بأحوالكم مذ خلقكم من تراب الأرض وإذ أنتم أجنة في بطون أمهاتكم فلا تمدحوا أنفسكم تزكيةً هو أعلم بالمتقين."
    }
  }
}