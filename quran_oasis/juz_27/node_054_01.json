  "tutorContext": {
    "surahName": "القمر",
    "juz": 27,
    "theme": "معجزة انشقاق القمر لرسول الله ﷺ، وإصرار كفار قريش على التكذيب، ووصف خروجهم من القبور مهطعين إلى الداعي.",
    "ayahMeanings": {
      "1": "قربت القيامة وانشق القمر فرقتين معجزة لرسول الله ﷺ.",
      "2": "وإن ير المشركون دلالة ومعجزة باهرة يعرضوا عنها ويقولوا: هذا سحر قوي مستمر.",
      "3": "وكذبوا بالحق واتبعوا أهواءهم الباطلة، وكل أمر سينتهي ويستقر إلى غايته وجزائه.",
      "4": "ولقد جاءهم في القرآن من أنباء الأمم المكذبة ما فيه كفاية لردعهم وزجرهم.",
      "5": "هذا القرآن حكمة بالغة في هدايته، ولكن ما تنفع النذر قوماً كتب عليهم الشقاء.",
      "6": "فأعرض عنهم وانتظر يوم يدعو إسرافيل إلى أمر فظيع شاق من أهوال القيامة.",
      "7": "ذليلة خاشعة أبصارهم يخرجون من قبورهم كأنهم جراد منتشر في كثرتهم واضطرابهم.",
      "8": "مسرعين مادي أعناقهم إلى صوت الداعي، يقول الكافرون حينئذ: هذا يوم شاق عسير."
    }
  }
}