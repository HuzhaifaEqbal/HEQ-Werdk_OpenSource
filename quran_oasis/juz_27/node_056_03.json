  "tutorContext": {
    "surahName": "الواقعة",
    "juz": 27,
    "theme": "بيان نعيم أصحاب اليمين في بساتين السدر منزوع الشوك، والموز المتراكم، والظل الممتد والماء المسكوب والحور الأبكار العرب الأتراب.",
    "ayahMeanings": {
      "27": "وأصحاب اليمين ما أعظم فوزهم وما أكرم منزلتهم!",
      "28": "في شجر سدر قُطع شوكه وأُبدل مكانه ثمراً حلواً.",
      "29": "وشجر موز (طلح) متراكم الثمر بعضه فوق بعض.",
      "30": "وظل دائم ممتد لا تنسخه شمس.",
      "31": "وماء جارٍ مسكوب يفيض بلا انقطاع.",
      "32": "وفواكه كثيرة متنوعة الألوان والطعوم.",
      "33": "لا تنقطع في زمن من الأزمنة ولا يمنع عنها أحد بحال.",
      "34": "وفرش مرفوعة في الهواء على السرر عالية القدر واللين.",
      "35": "إنا أنشأنا نساء الجنة نشأة جديدة بديعة لا يقربها هرم.",
      "36": "فجعلناهن جميعاً أبكاراً عذارى كلما أتاهن أزواجهن وجدوهن أبكاراً.",
      "37": "متحببات إلى أزواجهن حسنات الكلام متساويات في السن والشباب.",
      "38": "أُعد هذا النعيم العظيم إكراماً لأصحاب اليمين.",
      "39": "جماعة كثيرة من الأولين من الأمم السابقة.",
      "40": "وجماعة كثيرة من الآخرين من أمة محمد ﷺ."
    }
  }
}