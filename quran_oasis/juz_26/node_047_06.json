  "tutorContext": {
    "surahName": "محمد",
    "juz": 26,
    "theme": "إظهار أضغان المنافقين في فلتات ألسنتهم ولحن القول، وابتلاء الأمة لتمييز المجاهدين، والنهي عن الوهن في مواجهة الأعداء، والحث على الإنفاق في سبيل الله مع غنى الله المطلق.",
    "ayahMeanings": {
      "29": "أم ظن المنافقون أن لن يظهر الله أحقادهم وبغضهم للإسلام والمسلمين؟",
      "30": "ولو نشاء لأريناك أشخاصهم فلعرفتهم بعلاماتهم الظاهرة، ولتعرفنهم حتماً في أسلوب كلامهم وفلتات ألسنتهم، والله يعلم أعمالكم.",
      "31": "ولنختبرنكم بالتكاليف والجهاد حتى يظهر المجاهدون والصابرون وتُختبر أخباركم وأعمالكم.",
      "32": "إن الذين كفروا وصدوا عن سبيل الله وعادوا الرسول بعد وضوح الحق لن يضروا الله شيئاً وسيبطل أعمالهم.",
      "33": "يا أيها الذين آمنوا أطيعوا الله وأطيعوا الرسول ولا تبطلوا ثواب أعمالكم بالردة أو الرياء والمن.",
      "34": "إن الذين كفروا وصدوا عن سبيل الله ثم ماتوا على كفرهم فلن يغفر الله لهم أبداً.",
      "35": "فلا تضعفوا وتدعوا إلى الصلح والموادعة مع الكفار وأنتم الأعلون نصراً وقدراً والله معكم ولن ينقصكم أجور أعمالكم.",
      "36": "إنما الدنيا لعب ولهو زائل، وإن تؤمنوا وتتقوا يؤتكم أجوركم ولا يكلفكم بذل جميع أموالكم فيثقل عليكم.",
      "37": "إن يسألكم أموالكم فيلحف في طلبها تبخلوا ويخرج البخل أضغانكم المستورة.",
      "38": "ها أنتم تدعون للإنفاق في سبيل الله فمنكم من يبخل، ومن يبخل فإنما يبخل عن نفسه، والله هو الغني عن خلقه وأنتم الفقراء إليه، وإن تتولوا يستبدل قوماً غيركم ثم لا يكونوا أمثالكم في التخاذل بل يطيعون وينفقون."
    }
  }
