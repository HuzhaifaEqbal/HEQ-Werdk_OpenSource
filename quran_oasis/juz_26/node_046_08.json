  "tutorContext": {
    "surahName": "الأحقاف",
    "juz": 26,
    "theme": "إثبات قدرة الله على إحياء الموتى بخلق السماوات والأرض، وأمر النبي ﷺ بالصبر الجميل على أذى قومه اقتداءً بأولي العزم من الرسل.",
    "ayahMeanings": {
      "33": "أولم ير هؤلاء المكذبون أن الله الذي خلق السماوات والأرض ولم يعجز عن خلقهن بقادر على إحياء الموتى؟ بلى إنه على كل شيء قدير.",
      "34": "ويوم يُعرض الذين كفروا على النار يقال لهم: أليس هذا العذاب بالحق والصدق؟ قالوا: بلى وربنا، قال: فذوقوا العذاب بما كنتم تكفرون.",
      "35": "فاصبر أيها الرسول على تكذيب قومك وأذاهم كما صبر أولو العزم من الرسل (نوح وإبراهيم وموسى وعيسى)، ولا تستعجل لهم العذاب كأنهم يوم يرونه لم يلبثوا في الدنيا إلا ساعة من نهار، هذا القرآن بلاغ، فهل يهلك إلا القوم الفاسقون الخارجون عن طاعة الله؟"
    }
  }
