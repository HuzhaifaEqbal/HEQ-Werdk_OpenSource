  "tutorContext": {
    "surahName": "الأحقاف",
    "juz": 26,
    "theme": "عبرة الأمم السابقة المكذبة في محيط مكة، وقصة إسلام نفر الجن حين استمعوا للقرآن وتأثروا به ورجعوا إلى قومهم منذرين ومبلغين.",
    "ayahMeanings": {
      "26": "ولقد مكنا عاداً وأعطيناهم من القوة والمال ما لم نمكنكم فيه وجعلنا لهم أسماعاً وأبصاراً وعقولاً، فما أغنى عنهم سمعهم ولا بصرهم شيئاً إذ كانوا يجحدون بآيات الله وحاق بهم العذاب.",
      "27": "ولقد أهلكنا ما حولكم من القرى الكافرة كعاد وثمود وقوم لوط، وصرفنا الحجج لعلهم يرجعون.",
      "28": "فهلا نصرتهم تلك الأصنام التي اتخذوها آلهة وقرباناً؟ بل ضلت وغابت عنهم وتبرأت منهم.",
      "29": "واذكر إذ وجهنا إليك طائفة من الجن يستمعون القرآن، فلما حضروه قالوا: أنصتوا، فلما فرغ النبي من تلاوته رجعوا إلى قومهم منذرين.",
      "30": "قالوا: يا قومنا إنا سمعنا كتاباً أُنزل من بعد موسى مصدقاً لما قبله يهدي إلى الحق وإلى طريق مستقيم.",
      "31": "يا قومنا أجيبوا رسول الله محمد ﷺ وآمنوا به يغفر لكم ذنوبكم وينجكم من عذاب أليم.",
      "32": "ومن لا يجب داعي الله فليس بمعجز لله في الأرض هرباً، وليس له من دون الله أولياء ينصرونه، أولئك في ضلال مبين."
    }
  }
