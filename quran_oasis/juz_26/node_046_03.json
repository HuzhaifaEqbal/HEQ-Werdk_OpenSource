  "tutorContext": {
    "surahName": "الأحقاف",
    "juz": 26,
    "theme": "شبهة الكفار في استباق الفقراء للإسلام وتفنيدها، وتصديق القرآن للتوراة بلسان عربي، ووعد المستقيمين بالأمن والخلود في الجنة.",
    "ayahMeanings": {
      "11": "وقال الذين كفروا للمؤمنين كبراً: لو كان هذا الدين خيراً ما سبقنا إليه هؤلاء الضعفاء، فلما لم يهتدوا به قالوا: هذا كذب قديم مأثور.",
      "12": "ومن قبل القرآن كان كتاب موسى التوراة إماماً وهدى ورحمة، وهذا القرآن كتاب مصدق له بلسان عربي لينذر الظالمين ويبشر المحسنين.",
      "13": "إن الذين قالوا ربنا الله وحده ثم استقاموا على طاعته وشريعته فلا خوف عليهم مما يستقبلونه ولا هم يحزنون على ما فاتهم.",
      "14": "أولئك هم أهل الجنة خالدين فيها أبداً جزاءً وثواباً بما كانوا يعملون من الصالحات."
    }
  }
