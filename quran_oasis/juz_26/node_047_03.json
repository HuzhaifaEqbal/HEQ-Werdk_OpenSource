  "tutorContext": {
    "surahName": "محمد",
    "juz": 26,
    "theme": "الوعد الإلهي بنصر من ينصر دين الله وتثبيت أقدامهم، ووعيد الكافرين بالتعاسة والهلاك، وتشبيه تمتعهم في الدنيا بأكل الأنعام ومأواهم النار.",
    "ayahMeanings": {
      "7": "يا أيها الذين آمنوا إن تنصروا دين الله بالجهاد والامتثال ينصركم على أعدائكم ويثبت أقدامكم في الميادين.",
      "8": "والذين كفروا فهلاكاً وخيبة لهم، وأبطل الله أعمالهم فلا ينتفعون منها بشيء.",
      "9": "ذلك الهلاك لأنهم كرهوا القرآن الذي أنزله الله فأحبط أعمالهم.",
      "10": "أفلم يسيروا في الأرض فينظروا كيف كانت عاقبة الأمم المكذبة من قبلهم؟ دمر الله عليهم وللكافرين أمثال هذه العواقب.",
      "11": "ذلك لأن الله هو ناصر المؤمنين وحاميهم، وأن الكافرين لا ناصر ولا مولى لهم يدفع عنهم العذاب.",
      "12": "إن الله يدخل المؤمنين جنات تجري من تحتها الأنهار، والذين كفروا يتمتعون في دنياهم ويأكلون بغفلة كما تأكل الأنعام ومصيرهم النار مأوى لهم."
    }
  }
}