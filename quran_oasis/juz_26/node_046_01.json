  "tutorContext": {
    "surahName": "الأحقاف",
    "juz": 26,
    "theme": "بيان صدق القرآن وتنزيله من العزيز الحكيم، وإبطال عبادة الأصنام التي لا تخلق شيئاً ولا تسمع الدعاء وستتبرأ من عابديها يوم الحشر.",
    "ayahMeanings": {
      "1": "حم: حروف مقطعة للتحدي والإعجاز وبيان شرف القرآن.",
      "2": "تنزيل هذا القرآن العظيم صادر من الله العزيز في قدرته الحكيم في تدبيره وشرعه.",
      "3": "ما خلقنا السماوات والأرض وما بينهما إلا بالحق وإلى أجل مسمى مؤقت للانتهاء والجزاء، والكافرون عما أُنذروا به معرضون.",
      "4": "قل للمشركين: أروني ماذا خلقت آلهتكم من الأرض أم لها شِرك ونصيب في خلق السماوات؟ ائتوني بكتاب سماوي سابق أو بقية من علم تؤيد شرككم إن كنتم صادقين.",
      "5": "ومن أشد ضلالاً ممن يدعو من دون الله أصناماً لا تستجيب له إلى يوم القيامة وهي عن دعائهم غافلة لا تسمع ولا تعي؟",
      "6": "وإذا حُشر الناس يوم القيامة كانت هذه المعبودات أعداءً لعابديها وتبرأت من عبادتهم وجحدتها."
    }
  }
}